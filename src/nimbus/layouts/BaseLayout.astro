---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/globals.css";
import "../styles/prose.css";
import "../styles/markdown-pipeline.css";
import "tippy.js/dist/tippy.css";
import "../styles/tippy.css";
import "../styles/footnotes.css";
import PageHead from "@/components/PageHead.astro";
import type { PageMeta } from "@/components/PageHead.astro";
import type { BasePageProps } from "nimbus-docs/types";

type Props = BasePageProps & { footer?: boolean; meta?: PageMeta };
const { title, description, noindex, socialImage, head = [], meta } = Astro.props;
const path = Astro.url.pathname;
const lang = path.startsWith("/zh-CN/") ? "zh-CN" : path.startsWith("/zh-HK/") ? "zh-HK" : "en";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        const key = "ui-mode";
        const apply = () => {
          const stored = localStorage.getItem(key) || "auto";
          const dark = stored === "dark" || (stored === "auto" && matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.toggleAttribute("data-mode", dark);
          document.documentElement.setAttribute("data-theme", dark ? "dark" : "light");
          document.documentElement.setAttribute("data-nb-pref", stored);
          document.documentElement.setAttribute("data-nb-state", dark ? "dark" : "light");
        };
        window.__nbApplyTheme = apply;
        apply();
      })();
    </script>
    <PageHead title={title} description={description} noindex={noindex} socialImage={socialImage} head={head} meta={meta} />
  </head>
  <body class="bg-background text-foreground min-h-screen">
    <a href="#main-content" class="focus:bg-primary focus:text-primary-foreground sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-100 focus:rounded-md focus:px-4 focus:py-2">Skip to content</a>
    <slot />
    <script>
      import { codeCopy } from "nimbus-docs/client";
      import "../scripts/mobile-sidebar.client";
      import "../scripts/mermaid.client";
      import "../scripts/table-scroll.client";
      import "../scripts/image-zoom.client";
      import "../scripts/footnotes.client";
      import "../scripts/scroll-to-top.client";
      codeCopy();
    </script>
  </body>
</html>
