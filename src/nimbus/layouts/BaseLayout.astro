---
// Fonts are the site's choice, not the theme's: the theme ships no font
// import so it does not force the dependency. Keep these here.
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
// Base styles from the theme. Tooltip CSS is not listed: the theme loads
// tippy's stylesheet alongside the library the first time a tooltip is used.
import "../styles/site.css";
import "@longbridge/astro-theme-docs/styles/prose.css";
import "@longbridge/astro-theme-docs/styles/markdown-pipeline.css";
import "@longbridge/astro-theme-docs/styles/footnotes.css";
import PageHead from "@longbridge/astro-theme-docs/chrome/PageHead";
import type { PageMeta } from "@longbridge/astro-theme-docs/chrome/PageHead";
import type { BasePageProps } from "nimbus-docs/types";
import { ClientRouter } from "astro:transitions";

type Props = BasePageProps & { footer?: boolean; meta?: PageMeta };
const { title, description, noindex, socialImage, head = [], meta } = Astro.props;
// Brand values: the theme injects neither a title suffix nor a favicon.
const SITE_NAME = "Whale Docs";
const FAVICON_HREF =
	"https://assets.lbkrs.com/uploads/288a4391-d68f-45f2-aedc-007306bab1a5/whale-icon.png";
const path = Astro.url.pathname;
const lang = path.startsWith("/zh-cn/") ? "zh-CN" : path.startsWith("/zh-hk/") ? "zh-HK" : "en";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Pre-paint theme resolution — runs before first paint to avoid FOUC.
      // Reads the saved preference ("ui-mode": light | dark | auto), resolves
      // "auto" against the OS setting, and applies it to <html> via the
      // attributes the stylesheet keys off (data-mode for dark, data-nb-pref
      // for the toggle icon). ThemeToggle only writes localStorage and calls
      // window.__nbApplyTheme, so this script owns all DOM application.
      (function () {
        function apply() {
          var pref = "auto";
          try {
            var v = localStorage.getItem("ui-mode");
            if (v === "light" || v === "dark" || v === "auto") pref = v;
          } catch (e) {}
          var systemDark = false;
          try {
            systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          } catch (e) {}
          var mode = pref === "dark" || (pref === "auto" && systemDark) ? "dark" : "light";
          var root = document.documentElement;
          root.setAttribute("data-nb-pref", pref);
          root.setAttribute("data-mode", mode);
          root.setAttribute("data-theme", mode);
          root.style.colorScheme = mode;
        }
        window.__nbApplyTheme = apply;
        apply();
        if (!window.__nbThemeBound) {
          window.__nbThemeBound = true;
          try {
            window
              .matchMedia("(prefers-color-scheme: dark)")
              .addEventListener("change", function () {
                if (window.__nbApplyTheme) window.__nbApplyTheme();
              });
          } catch (e) {}
          // ClientRouter view transitions replace <html>; reapply after swap.
          document.addEventListener("astro:after-swap", function () {
            if (window.__nbApplyTheme) window.__nbApplyTheme();
          });
        }
      })();
    </script>
    <PageHead title={title} description={description} noindex={noindex} socialImage={socialImage} head={head} meta={meta} siteName={SITE_NAME} faviconHref={FAVICON_HREF} />
    <ClientRouter />
  </head>
  <body class="bg-background text-foreground min-h-screen">
    <a href="#main-content" class="focus:bg-primary focus:text-primary-foreground sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-100 focus:rounded-md focus:px-4 focus:py-2">Skip to content</a>
    <slot />
    <script>
      import { codeCopy } from "nimbus-docs/client";
      import "@longbridge/astro-theme-docs/scripts/mobile-sidebar.client";
      import "@longbridge/astro-theme-docs/scripts/mermaid.client";
      import "@longbridge/astro-theme-docs/scripts/table-scroll.client";
      import "@longbridge/astro-theme-docs/scripts/image-zoom.client";
      import "@longbridge/astro-theme-docs/scripts/footnotes.client";
      import "@longbridge/astro-theme-docs/scripts/scroll-to-top.client";
      codeCopy();
    </script>
  </body>
</html>
