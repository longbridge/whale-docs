---
import { Icon } from "astro-icon/components";
import type { DocsPageProps } from "nimbus-docs/types";
import BaseLayout from "./BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { Sidebar, SidebarStateRestore } from "@/components/ui/sidebar";
import { TOC, MobileTOC } from "@/components/ui/toc";
import { Pagination } from "@/components/ui/pagination";
import { PageActions, PageActionLinks } from "@/components/ui/page-actions";
import { ScrollToTop } from "@/components/ui/scroll-to-top";

type Props = DocsPageProps & { wide?: boolean; feedback?: boolean; descriptionHtml?: string };
const { title, description, descriptionHtml, sidebar, headings, prevNext, markdownUrl, lastUpdated, editUrl, wide = false } = Astro.props;
const showSidebar = sidebar !== false;
const showToc = headings !== false && headings.length > 0;
const isApiSidebar = Astro.url.pathname.split("/").filter(Boolean)[1] === "broker-api";
function currentGroup(items: typeof sidebar): string | undefined {
  if (!Array.isArray(items)) return undefined;
  for (const item of items) {
    if (item.type === "group") {
      if (item.children.some((child) => child.type === "link" && child.isCurrent)) return item.label;
      const nested = currentGroup(item.children);
      if (nested) return nested;
    }
  }
}
const groupLabel = currentGroup(sidebar);
---

<BaseLayout title={title} description={description} markdownUrl={markdownUrl} lastUpdated={lastUpdated}>
  <div class="flex min-h-screen flex-col">
    <Header showSidebar={showSidebar} />
    <div class="flex flex-1">
      {showSidebar && (
        <aside id="desktop-sidebar" data-sidebar-home data-nb-desktop-sidebar data-nb-api-sidebar={isApiSidebar ? "" : undefined} class="bg-background sticky top-[7.5rem] hidden h-[calc(100vh-7.5rem)] w-(--nb-sidebar-width) shrink-0 overflow-y-auto overscroll-contain lg:block">
          <nav data-shared-sidebar-nav class="pt-7 pb-14" style="padding-inline: calc(var(--nb-shell-gutter) - 0.75rem)">
            <Sidebar items={sidebar} persist />
          </nav>
          <div class="from-background pointer-events-none sticky bottom-0 h-10 bg-gradient-to-t to-transparent"></div>
        </aside>
      )}
      {showSidebar && <SidebarStateRestore />}

      <div class="flex min-w-0 flex-1 flex-col">
        <div class="flex min-w-0 flex-1">
          <main id="main-content" class="min-w-0 flex-1">
            <div class:list={["mx-auto w-full px-6 pb-16", wide ? "max-w-[1400px] pt-6 lg:px-8" : "max-w-(--nb-content-max) pt-10 lg:px-10"]}>
              {groupLabel && <div class:list={["text-primary text-sm font-semibold", wide ? "mb-2" : "mb-5"]}>{groupLabel}</div>}
              <div id="_top">
                <div class="flex items-start justify-between gap-6"><div class="min-w-0"><h1 class="text-foreground mb-0 leading-tight" style={`font-size:${isApiSidebar ? "1.875rem" : "var(--nb-h1-size)"};font-weight:var(--nb-h1-weight);letter-spacing:var(--nb-h1-tracking)`}>{title}</h1>{descriptionHtml ? <div class:list={["api-page-description text-muted-foreground", isApiSidebar ? "mt-1.5 text-base leading-6" : wide ? "mt-2 text-lg leading-7" : "mt-3 text-lg leading-relaxed"]} set:html={descriptionHtml} /> : description && <p class:list={["text-muted-foreground", isApiSidebar ? "mt-1.5 text-base leading-6" : wide ? "mt-2 text-lg leading-7" : "mt-3 text-lg leading-relaxed"]}>{description}</p>}</div><PageActions lastUpdated={lastUpdated} class="mt-1 shrink-0" /></div>
                {showToc && <div class="border-border bg-background/95 sticky top-[7.5rem] z-20 -mx-6 mt-5 border-y px-6 py-2 backdrop-blur xl:hidden"><MobileTOC headings={headings} /></div>}
                <article class:list={["docs-content max-w-none", wide ? "mt-5" : "mt-8"]}><slot /></article>
              </div>
              <Pagination prevNext={prevNext} />
              <div class="mt-10 xl:hidden"><PageActionLinks editUrl={editUrl} /></div>
            </div>
          </main>

          {showToc && (
            <aside data-nb-toc-scroll-host class="sticky top-[7.5rem] hidden h-[calc(100vh-7.5rem)] w-(--nb-toc-width) shrink-0 overflow-y-auto overscroll-contain xl:block">
              <div class="px-7 pt-10 pb-10"><TOC headings={headings} /><div class="mt-8 pt-6"><PageActionLinks editUrl={editUrl} /></div></div>
            </aside>
          )}
        </div>
      </div>
    </div>
    <Footer />
  </div>

  {showSidebar && (
    <dialog data-mobile-sidebar data-state="closed" class="group fixed inset-0 z-50 m-0 h-full max-h-full w-full max-w-full border-0 bg-transparent p-0 aria-modal:bg-black/40" aria-label="Site navigation">
      <div data-mobile-sidebar-panel class="bg-background h-full w-[min(23rem,90vw)] -translate-x-full overflow-y-auto shadow-xl transition-transform duration-250 group-data-[state=open]:translate-x-0">
        <div class="border-border sticky top-0 z-10 flex items-center justify-between border-b bg-inherit px-5 py-4"><span class="font-semibold">Whale Docs</span><button data-close-sidebar class="hover:bg-accent flex size-9 items-center justify-center rounded-md" aria-label="Close navigation"><Icon name="ph:x" class="size-5" /></button></div>
        <div data-mobile-sidebar-slot />
      </div>
    </dialog>
  )}
  <ScrollToTop />
</BaseLayout>

<script>
  function initializeSidebarScrollbar() {
    const sidebar = document.querySelector<HTMLElement>("#desktop-sidebar");
    if (!sidebar || sidebar.dataset.scrollbarBound === "true") return;

    sidebar.dataset.scrollbarBound = "true";
    let hideTimer: number | undefined;

    sidebar.addEventListener("scroll", () => {
      sidebar.dataset.scrollbarVisible = "";
      window.clearTimeout(hideTimer);
      hideTimer = window.setTimeout(() => {
        delete sidebar.dataset.scrollbarVisible;
      }, 800);
    }, { passive: true });
  }

  initializeSidebarScrollbar();
  document.addEventListener("astro:page-load", initializeSidebarScrollbar);
</script>
