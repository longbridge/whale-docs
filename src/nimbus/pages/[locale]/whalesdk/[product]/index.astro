---
export const prerender = true;

export function getStaticPaths() {
  return (["en", "zh-cn", "zh-hk"] as const).flatMap((locale) =>
    (["whaleapp", "whalecore"] as const).map((product) => ({
      params: { locale, product },
      props: { overview: `/${locale}/whalesdk/${product}/overview` },
    })),
  );
}

return Astro.redirect(Astro.props.overview, 302);
---
