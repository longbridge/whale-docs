---
import DocsLayout from "../../../../../layouts/DocsLayout.astro";
import { getPrevNext } from "nimbus-docs";
import { allOperations, operationPath, resolveSchema, type OperationRecord } from "../../../../../lib/openapi";
import { getWhaleSidebar } from "../../../../../lib/whale-navigation";

export const prerender = true;
export function getStaticPaths() {
  return allOperations().map((record) => ({
    params: { locale: record.locale, method: record.method, path: operationPath(record.path) },
    props: record,
  }));
}

const { locale, method, path, operation, document } = Astro.props as OperationRecord;
const title = operation.summary || operation.operationId || `${method.toUpperCase()} ${path}`;
const sidebar = await getWhaleSidebar(Astro.url.pathname);
const currentSlug = Astro.url.pathname.replace(/\/$/, "");
const prevNext = await getPrevNext(currentSlug, { sidebarTree: sidebar });
const requestContent = operation.requestBody?.content ?? {};
const requestType = Object.keys(requestContent)[0];
const request = requestType ? requestContent[requestType] : undefined;
const parameters = (operation.parameters ?? []).map((parameter: any) => parameter.$ref ? resolveSchema(document, parameter) : parameter);
const responses = Object.entries(operation.responses ?? {}) as [string, any][];
const labels = locale === "en"
  ? { reference: "API Reference", parameters: "Parameters", request: "Request body", responses: "Responses", required: "Required", optional: "Optional" }
  : locale === "zh-CN"
    ? { reference: "API 参考", parameters: "参数", request: "请求体", responses: "响应", required: "必填", optional: "可选" }
    : { reference: "API 參考", parameters: "參數", request: "請求體", responses: "響應", required: "必填", optional: "可選" };
const headings = [
  ...(parameters.length ? [{ depth: 2, text: labels.parameters, slug: "parameters" }] : []),
  ...(request ? [{ depth: 2, text: labels.request, slug: "request-body" }] : []),
  { depth: 2, text: labels.responses, slug: "responses" },
];
const example = request?.example ?? request?.examples?.default?.value;
---

<DocsLayout
  title={title}
  description={operation.description}
  sidebar={sidebar}
  headings={headings}
  breadcrumbs={[
    { label: "Whale Docs", href: `/${locale}/introduction/` },
    { label: "Broker API", href: `/${locale}/broker-api/overview/` },
    { label: labels.reference },
  ]}
  prevNext={prevNext}
  wide={false}
>
  <div class="api-operation-heading">
    <span class:list={["api-method", `api-method-${method}`]}>{method.toUpperCase()}</span>
    <code>{path}</code>
  </div>

  {operation.description && <p>{operation.description}</p>}

  {parameters.length > 0 && <section><h2 id="parameters">{labels.parameters}</h2><div class="api-fields">{parameters.map((parameter: any) => {
    const schema = resolveSchema(document, parameter.schema);
    return <div class="api-field"><div class="api-field-title"><code>{parameter.name}</code><span>{schema?.type ?? "string"}</span><em>{parameter.required ? labels.required : labels.optional}</em></div>{parameter.description && <p>{parameter.description}</p>}</div>;
  })}</div></section>}

  {request && <section><h2 id="request-body">{labels.request}</h2>{requestType && <p><code>{requestType}</code></p>}<pre data-language="json"><code>{JSON.stringify(example ?? resolveSchema(document, request.schema), null, 2)}</code></pre></section>}

  <section><h2 id="responses">{labels.responses}</h2><div class="api-responses">{responses.map(([status, response]) => {
    const contentType = Object.keys(response.content ?? {})[0];
    const body = contentType ? response.content[contentType] : undefined;
    return <details open={status === "200"}><summary><code>{status}</code><span>{response.description || (status === "200" ? "OK" : "Response")}</span></summary>{contentType && <p><code>{contentType}</code></p>}{body && <pre data-language="json"><code>{JSON.stringify(body.example ?? resolveSchema(document, body.schema), null, 2)}</code></pre>}</details>;
  })}</div></section>
</DocsLayout>
