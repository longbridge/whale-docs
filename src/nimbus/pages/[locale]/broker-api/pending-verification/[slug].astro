---
/**
 * Placeholder page for a Broker API sidebar branch whose every operation is
 * currently `x-verified: unverified`. Rendered from `pending-verification.json`
 * (a build artifact regenerated by `scripts/convert.py`, same as docs.json /
 * openapi.*.json) rather than one physical .mdx file per branch per language
 * -- with ~340 branches x 3 languages that was ~1000 files to keep in sync by
 * hand-rerunning convert.py; a stale file left behind after a branch got
 * re-verified was easy to miss in review. A manifest + dynamic route means
 * there is nothing to forget to delete: an unlisted slug simply 404s.
 */
import DocsLayout from "../../../../layouts/DocsLayout.astro";
import { getPrevNext } from "nimbus-docs";
import { getWhaleSidebar } from "../../../../lib/whale-navigation";
import { renderMarkdown } from "@longbridge/astro-theme-docs/lib/render-markdown";
import manifest from "../../../../../../pending-verification.json";

export const prerender = true;

interface PendingEntry {
  title: string;
  description: string;
  body: string;
}

export function getStaticPaths() {
  return Object.entries(manifest as Record<string, Record<string, PendingEntry>>).flatMap(
    ([locale, bySlug]) =>
      Object.entries(bySlug).map(([slug, entry]) => ({
        params: { locale, slug },
        props: entry,
      })),
  );
}

const { locale } = Astro.params;
const { title, description, body } = Astro.props as PendingEntry;
const sidebar = await getWhaleSidebar(Astro.url.pathname);
const currentSlug = Astro.url.pathname.replace(/\/$/, "");
const prevNext = await getPrevNext(currentSlug, { sidebarTree: sidebar });
const bodyHtml = renderMarkdown(body);
---

<DocsLayout
  title={title}
  description={description}
  sidebar={sidebar}
  headings={false}
  breadcrumbs={[
    { label: "Whale Docs", href: `/${locale}/introduction/` },
    { label: "Broker API", href: `/${locale}/broker-api/overview/` },
    { label: title },
  ]}
  prevNext={prevNext}
>
  <Fragment set:html={bodyHtml} />
</DocsLayout>
