---
import DocsLayout from "../layouts/DocsLayout.astro";
import { getCollection, render } from "astro:content";
import {
  getBreadcrumbs,
  getPrevNext,
  getTOC,
} from "nimbus-docs";
import { components } from "../mdx-components";
import { getWhaleSidebar } from "../lib/whale-navigation";

export const prerender = true;
export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries.map((entry) => ({
    params: {
      slug: entry.id
        .replace(/^zh-cn(?=\/|$)/, "zh-CN")
        .replace(/^zh-hk(?=\/|$)/, "zh-HK")
        .replace(/\.(md|mdx)$/, "")
        .replace(/\/index$/, ""),
    },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const currentSlug = Astro.url.pathname.replace(/\/$/, "") || "/";
const sidebar = await getWhaleSidebar(Astro.url.pathname);
const prevNext = await getPrevNext(currentSlug, { sidebarTree: sidebar });
const breadcrumbs = await getBreadcrumbs(currentSlug, { collection: entry.collection });
const toc = getTOC(headings.filter((heading) => heading.slug !== "footnote-label"));
const markdownUrl = `/${entry.id}/index.md`;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  sidebar={sidebar}
  headings={toc}
  breadcrumbs={breadcrumbs}
  prevNext={prevNext}
  markdownUrl={markdownUrl}
  collection={entry.collection}
  entryId={entry.id}
  wide={entry.data.wide}
  feedback={entry.data.feedback}
>
  <Content components={components} />
</DocsLayout>
