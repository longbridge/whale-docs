---
import DocsLayout from "../layouts/DocsLayout.astro";
import { getCollection, render } from "astro:content";
import {
  getBreadcrumbs,
  getPrevNext,
  getTOC,
} from "nimbus-docs";
import { components } from "../mdx-components";
import { getWhaleSidebar } from "../lib/whale-navigation";

export const prerender = true;
export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries.map((entry) => ({
    params: {
      slug: entry.id
        .replace(/^zh-cn(?=\/|$)/i, "zh-cn")
        .replace(/^zh-hk(?=\/|$)/i, "zh-hk")
        .replace(/\.(md|mdx)$/, "")
        .replace(/\/index$/, ""),
    },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const currentSlug = Astro.url.pathname.replace(/\/$/, "") || "/";
// Standalone guide pages (e.g. Whale Console) render on their own — no sidebar,
// TOC, or prev/next pagination.
const pageSlug = entry.id.replace(/\.(md|mdx)$/, "").replace(/^(en|zh-cn|zh-hk)\//i, "");
const isStandalone = pageSlug === "whale-console";
const sidebar = isStandalone ? false : await getWhaleSidebar(Astro.url.pathname);
const prevNext = isStandalone ? undefined : await getPrevNext(currentSlug, { sidebarTree: sidebar });
const breadcrumbs = await getBreadcrumbs(currentSlug, { collection: entry.collection });
// Astro includes MDX's explicit `{/* english-anchor */}` marker in heading
// metadata even though the marker is not visible in the rendered heading.
// Remove only that trailing marker before the metadata reaches the TOC.
const tocHeadings = headings
  .filter((heading) => heading.slug !== "footnote-label")
  .map((heading) => ({
    ...heading,
    text: heading.text.replace(/\s*\/\*\s*[\w-]+\s*\*\/\s*$/, ""),
  }));
const toc = getTOC(tocHeadings);
const markdownUrl = `/${entry.id}/index.md`;
const editUrl = `https://github.com/longbridge/whale-docs/edit/main/docs/${entry.id}.mdx`;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  sidebar={sidebar}
  headings={isStandalone ? false : toc}
  breadcrumbs={breadcrumbs}
  prevNext={prevNext}
  markdownUrl={markdownUrl}
  editUrl={editUrl}
  collection={entry.collection}
  entryId={entry.id}
  wide={entry.data.wide}
  feedback={entry.data.feedback}
>
  <Content components={components} />
</DocsLayout>
