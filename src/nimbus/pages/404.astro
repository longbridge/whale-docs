---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { LucideIcon } from "@longbridge/astro-theme-docs/ui/icon";
---

<BaseLayout title="Page not found" description="The requested documentation page could not be found.">
  <div class="flex min-h-screen flex-col">
    <Header showSidebar={false} />
    <main id="main-content" class="flex flex-1 items-center justify-center px-6 py-20">
      <section class="mx-auto w-full max-w-xl text-center">
        <p class="text-primary mb-4 font-mono text-sm font-semibold">404</p>
        <h1 class="text-foreground text-4xl font-semibold tracking-tight">Page not found</h1>
        <p class="text-muted-foreground mt-4 text-base leading-7">
          The page may have moved, or the address may be incorrect. Use the product navigation above or return to the documentation home.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a href="/en/overview" class="bg-primary/10 text-primary hover:bg-primary/20 inline-flex h-9 items-center gap-2 rounded-md px-4 text-sm font-medium no-underline transition-colors">
            <LucideIcon name="book-open" class="size-4" />
            Documentation home
          </a>
          <button type="button" data-go-back class="border-border hover:bg-accent inline-flex h-9 cursor-pointer items-center gap-2 rounded-md border bg-card px-4 text-sm font-medium">
            <LucideIcon name="arrow-left" class="size-4" />
            Go back
          </button>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>

<script>
  document.querySelector<HTMLButtonElement>("[data-go-back]")?.addEventListener("click", () => history.back());
</script>
