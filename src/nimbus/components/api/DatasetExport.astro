---
import type { OpenApiDocument, OperationRecord } from "../../lib/openapi";
import {
  operationRoutePath,
  resolveDatasetDownload,
} from "../../lib/openapi";
import { DatasetExportCard } from "@components/DatasetExportCard";

type Props = {
  locale: OperationRecord["locale"];
  operation: Record<string, any>;
  document: OpenApiDocument;
  baseUrl: string;
};

const { locale, operation, document, baseUrl } = Astro.props;
const download = resolveDatasetDownload(document, operation);
const labels = locale === "en"
  ? {
      title: "Export",
      descriptionBefore: "The export endpoint uses the same ",
      descriptionAfter: " as this Dataset query.",
      copy: "Copy endpoint",
      copied: "Endpoint copied",
      records: "Export records",
      downloadInfo: "Download result",
      detail: "Export options",
    }
  : locale === "zh-CN"
    ? {
        title: "导出",
        descriptionBefore: "导出接口使用与此 Dataset 查询相同的 ",
        descriptionAfter: "。",
        copy: "复制接口地址",
        copied: "接口地址已复制",
        records: "导出记录",
        downloadInfo: "下载结果",
        detail: "导出选项",
      }
    : {
        title: "匯出",
        descriptionBefore: "匯出介面使用與此 Dataset 查詢相同的 ",
        descriptionAfter: "。",
        copy: "複製介面位址",
        copied: "介面位址已複製",
        records: "匯出記錄",
        downloadInfo: "下載結果",
        detail: "匯出選項",
      };
const endpointUrl = download ? `${baseUrl}${download.link.path}` : "";
const datasetName = download
  ? (download.link.path.match(/\/v1\/datasets\/([^/]+)\/download$/)?.[1] ?? "")
  : "";
const localePath = locale.toLowerCase();
const exportDetailHref = datasetName
  ? `/${localePath}/broker-api/dataset-export?name=${datasetName}`
  : `/${localePath}/broker-api/dataset-export`;
const exportRecordsHref = `/${localePath}/broker-api/${operationRoutePath(
  locale,
  "GET",
  "/v1/datasets/download_records",
)}`;
const downloadInfoHref = `/${localePath}/broker-api/${operationRoutePath(
  locale,
  "GET",
  "/v1/datasets/download/{id}",
)}`;
---

{download && (
  <DatasetExportCard
    client:load
    title={labels.title}
    descriptionBefore={labels.descriptionBefore}
    descriptionAfter={labels.descriptionAfter}
    endpoint={endpointUrl}
    copyLabel={labels.copy}
    copiedLabel={labels.copied}
    detail={{ label: labels.detail, href: exportDetailHref }}
    records={{ label: labels.records, href: exportRecordsHref }}
    downloads={{ label: labels.downloadInfo, href: downloadInfoHref }}
  />
)}
