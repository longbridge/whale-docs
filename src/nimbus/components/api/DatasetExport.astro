---
import type { OpenApiDocument, OperationRecord } from "../../lib/openapi";
import {
  operationRoutePath,
  resolveDatasetDownload,
  resolveSchema,
} from "../../lib/openapi";
import { renderMarkdown } from "../../lib/render-markdown";
import ApiEndpointCopy from "./ApiEndpointCopy.astro";
import ApiSchemaFields from "./ApiSchemaFields.astro";
import { Badge } from "@components/components/ui/badge";

type Props = {
  locale: OperationRecord["locale"];
  operation: Record<string, any>;
  document: OpenApiDocument;
  baseUrl: string;
};

const { locale, operation, document, baseUrl } = Astro.props;
const download = resolveDatasetDownload(document, operation);
const requestContent = download?.operation.requestBody?.content ?? {};
const requestType = Object.keys(requestContent)[0];
const request = requestType ? requestContent[requestType] : undefined;
const requestSchema = resolveSchema(document, request?.schema);
const exportProperties = Object.fromEntries(
  Object.entries(requestSchema?.properties ?? {}).filter(
    ([name]) => name !== "filters",
  ),
);
const exportSchema = {
  type: "object",
  properties: exportProperties,
  required: (requestSchema?.required ?? []).filter(
    (name: string) => name !== "filters" && name in exportProperties,
  ),
};
if (exportSchema.required.length === 0) delete exportSchema.required;
const labels = locale === "en"
  ? {
      title: "Export",
      description:
        "The export endpoint uses the same `filters` as this Dataset query. Expand this section for export-specific options.",
      request: "Export options",
      copy: "Copy endpoint",
      copied: "Endpoint copied",
      records: "View export records",
      downloadInfo: "View asynchronous download details",
    }
  : locale === "zh-CN"
    ? {
        title: "导出",
        description:
          "导出接口使用与此 Dataset 查询相同的 `filters`。展开此部分可查看导出专用选项。",
        request: "导出选项",
        copy: "复制接口地址",
        copied: "接口地址已复制",
        records: "查看导出记录",
        downloadInfo: "查看异步下载说明",
      }
    : {
        title: "匯出",
        description:
          "匯出介面使用與此 Dataset 查詢相同的 `filters`。展開此部分可查看匯出專用選項。",
        request: "匯出選項",
        copy: "複製介面位址",
        copied: "介面位址已複製",
        records: "查看匯出記錄",
        downloadInfo: "查看異步下載說明",
      };
const endpointUrl = download ? `${baseUrl}${download.link.path}` : "";
const localePath = locale.toLowerCase();
const exportRecordsHref = `/${localePath}/broker-api/${operationRoutePath(
  locale,
  "GET",
  "/v1/datasets/download_records",
)}`;
const downloadInfoHref = `/${localePath}/broker-api/${operationRoutePath(
  locale,
  "GET",
  "/v1/datasets/download/{id}",
)}`;
---

{download && (
  <details class="dataset-export">
    <summary>{labels.title}</summary>
    <div class="dataset-export-content">
      <div set:html={renderMarkdown(labels.description)} />
      <p>
        <a href={exportRecordsHref}>{labels.records}</a>
        {" · "}
        <a href={downloadInfoHref}>{labels.downloadInfo}</a>
      </p>
      <div class="api-operation-heading">
        <Badge className={`api-method api-method-${download.link.method.toLowerCase()}`}>
          {download.link.method.toUpperCase()}
        </Badge>
        <code>{endpointUrl}</code>
        <ApiEndpointCopy
          text={endpointUrl}
          label={labels.copy}
          copiedLabel={labels.copied}
        />
      </div>
      {Object.keys(exportProperties).length > 0 && (
        <>
          <h3>{labels.request} <small>{requestType}</small></h3>
          <ApiSchemaFields
            schema={exportSchema}
            document={document}
            locale={locale}
            childrenOpen={false}
          />
        </>
      )}
    </div>
  </details>
)}

<style>
  .dataset-export {
    border-block: 1px solid var(--sl-color-gray-5, #d8dee9);
    padding-block: 0.85rem;
  }

  .dataset-export summary {
    cursor: pointer;
    font-weight: 650;
  }

  .dataset-export-content {
    padding-block-start: 1rem;
  }
</style>
