---
import { resolveSchema, type OpenApiDocument } from "../../lib/openapi";
import { Badge } from "@components/components/ui/badge";
import { renderMarkdown } from "../../lib/render-markdown";

interface Props {
  schema: any;
  document: OpenApiDocument;
  prefix?: string;
  locale: "en" | "zh-CN" | "zh-HK";
  childrenOpen?: boolean;
}

const { schema: rawSchema, document, prefix = "", locale, childrenOpen = true } = Astro.props;
const schema = resolveSchema(document, rawSchema) ?? {};
const properties = Object.entries(schema.properties ?? {}) as [string, any][];
const required = new Set<string>(schema.required ?? []);
const requiredLabel = locale === "en" ? "required" : locale === "zh-CN" ? "必填" : "必填";
const childLabel = locale === "en" ? "Child attributes" : locale === "zh-CN" ? "子属性" : "子屬性";
---

<div class="api-schema-fields" data-slot="api-schema-fields">
  {properties.map(([name, unresolved]) => {
    const field = resolveSchema(document, unresolved) ?? unresolved;
    const fieldName = prefix ? `${prefix}.${name}` : name;
    const hasChildren = Boolean(field?.properties && Object.keys(field.properties).length);
    const type = field?.type === "array" ? `array<${field.items?.type ?? "object"}>` : field?.type ?? "object";
    return (
      <div class="api-schema-field" data-slot="api-schema-field">
        <div class="api-schema-field-meta" data-slot="api-schema-field-meta">
          <code>{fieldName}</code>
          <Badge variant="secondary">{type}</Badge>
          {required.has(name) && <Badge variant="destructive">{requiredLabel}</Badge>}
        </div>
        {field?.description && <div class="api-field-description" set:html={renderMarkdown(field.description)} />}
        {field?.enum && <p class="api-schema-enum">{field.enum.map((value: unknown) => <code>{String(value)}</code>)}</p>}
        {hasChildren && (
          <details class="api-schema-children" data-slot="accordion-item" open={childrenOpen}>
            <summary data-slot="accordion-trigger">
              <span>{childLabel}</span>
              <span class="api-schema-chevron" aria-hidden="true"></span>
            </summary>
            <Astro.self schema={field} document={document} prefix={fieldName} locale={locale} childrenOpen={childrenOpen} />
          </details>
        )}
      </div>
    );
  })}
</div>
