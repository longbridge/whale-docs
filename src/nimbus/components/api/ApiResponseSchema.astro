---
import { Badge } from "@components/components/ui/badge";
import { resolveSchema, type OpenApiDocument } from "../../lib/openapi";
import ApiSchemaFields from "./ApiSchemaFields.astro";
import { renderMarkdown } from "../../lib/render-markdown";

interface Props {
  schema: any;
  document: OpenApiDocument;
  locale: "en" | "zh-CN" | "zh-HK";
}

const { schema: rawSchema, document, locale } = Astro.props;
const schema = resolveSchema(document, rawSchema) ?? {};
const properties = schema.properties ?? {};
const isStandardEnvelope = ["code", "message", "data"].every((name) => name in properties);
const dataField = isStandardEnvelope ? resolveSchema(document, properties.data) ?? properties.data : undefined;
const dataSchema = dataField?.type === "array"
  ? resolveSchema(document, dataField.items) ?? dataField.items
  : dataField;
const dataType = dataField?.type === "array" ? `array<${dataSchema?.type ?? "object"}>` : dataField?.type ?? "object";
const labels = locale === "en"
  ? { envelope: "Standard response envelope", data: "data structure", empty: "No nested fields" }
  : locale === "zh-CN"
    ? { envelope: "标准响应结构", data: "data 数据结构", empty: "无子字段" }
    : { envelope: "標準響應結構", data: "data 數據結構", empty: "無子欄位" };
const hasDataProperties = Boolean(dataSchema?.properties && Object.keys(dataSchema.properties).length);
---

{isStandardEnvelope ? (
  <div class="api-response-envelope" data-slot="api-response-envelope">
    <div class="api-response-envelope-summary">
      <span>{labels.envelope}</span>
      <code>code</code>
      <code>message</code>
      <code>data</code>
    </div>
    <div class="api-response-data-heading">
      <code>data</code>
      <Badge variant="secondary">{dataType}</Badge>
      <span>{labels.data}</span>
    </div>
    {dataField?.description && <div class="api-response-data-description" set:html={renderMarkdown(dataField.description)} />}
    {hasDataProperties
      ? <div class="api-response-data-fields"><ApiSchemaFields schema={dataSchema} document={document} locale={locale} /></div>
      : <p class="api-response-data-empty">{labels.empty}</p>}
  </div>
) : (
  <ApiSchemaFields schema={schema} document={document} locale={locale} />
)}
