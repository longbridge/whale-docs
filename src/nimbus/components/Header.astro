---
import LucideIcon from "@/components/ui/icon/LucideIcon.astro";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { DocSearch } from "@/components/ui/search";
import { HeaderMenu } from "@components/HeaderMenu";
import { ThemeMenu } from "@components/ThemeMenu";
import lightLogo from "../../../logo/whale-light.png";
import darkLogo from "../../../logo/whale-dark.png";

interface Props { showSidebar?: boolean }
const { showSidebar = true } = Astro.props;
const pathname = Astro.url.pathname;
const locale = pathname.startsWith("/zh-cn/") ? "zh-CN" : pathname.startsWith("/zh-hk/") ? "zh-HK" : "en";
const localePath = locale.toLowerCase();
const suffix = pathname.replace(/^\/(en|zh-cn|zh-hk)(?=\/|$)/, "") || "/overview";
const languageOptions = [
  { label: "English", href: `/en${suffix}`, active: locale === "en" },
  { label: "简体中文", href: `/zh-cn${suffix}`, active: locale === "zh-CN" },
  { label: "繁體中文", href: `/zh-hk${suffix}`, active: locale === "zh-HK" },
];
// Fifth element marks an "aside" tab: pinned to the right of the nav (external
// platforms / guides), rendered compactly without a leading icon. Sixth element
// is an optional status badge.
const tabs = [
  ["Docs", "book-open", `/${localePath}/overview`, ["docs", "overview", "design-system"], false, undefined],
  ["WhaleSDK", "package", `/${localePath}/whalesdk/overview`, ["whalesdk"], false, undefined],
  ["BrokerAPI", "square-terminal", `/${localePath}/broker-api/overview`, ["broker-api"], false, undefined],
  ["TradingAPI", "layers", `/${localePath}/trading-api/overview`, ["trading-api"], false, undefined],
  ["Whale Console", "gauge", `/${localePath}/whale-console`, ["whale-console"], true, undefined],
  ["OpenAPI", "plug", "https://open.longportapp.com", ["openapi"], true, undefined],
] as const;
const section = pathname.split("/").filter(Boolean)[1] ?? "overview";
---

<header data-nb-header class="site-header sticky top-0 z-30">
  <div class="relative mx-auto flex h-[4.5rem] w-full max-w-(--nb-shell-max) items-center gap-5 px-(--nb-shell-gutter)">
    <a href={`/${localePath}/overview`} aria-label="Whale Docs" class="flex shrink-0 items-center no-underline">
      <img src={lightLogo.src} alt="Longport Whale" width="170" height="48" class="logo-light h-7 w-auto" />
      <img src={darkLogo.src} alt="Longport Whale" width="170" height="48" class="logo-dark h-7 w-auto" />
    </a>
    <div><HeaderMenu client:load options={languageOptions} /></div>
    <div class="absolute left-1/2 hidden -translate-x-1/2 md:flex"><DocSearch /></div>
    <div class="ml-auto flex items-center gap-2">
      <ThemeMenu client:load />
      <a href="https://github.com/longbridge/whale-docs" target="_blank" rel="noopener" aria-label="GitHub" class="text-muted-foreground hover:text-foreground hover:bg-accent hidden size-9 shrink-0 items-center justify-center rounded-lg transition-colors sm:inline-flex">
        <svg viewBox="0 0 24 24" class="size-[1.15rem]" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12c0 5.303 3.438 9.8 8.205 11.385c.6.113.82-.258.82-.577c0-.285-.01-1.04-.015-2.04c-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729c1.205.084 1.838 1.236 1.838 1.236c1.07 1.835 2.809 1.305 3.495.998c.108-.776.417-1.305.76-1.605c-2.665-.3-5.466-1.332-5.466-5.93c0-1.31.465-2.38 1.235-3.22c-.135-.303-.54-1.523.105-3.176c0 0 1.005-.322 3.3 1.23c.96-.267 1.98-.399 3-.405c1.02.006 2.04.138 3 .405c2.28-1.552 3.285-1.23 3.285-1.23c.645 1.653.24 2.873.12 3.176c.765.84 1.23 1.91 1.23 3.22c0 4.61-2.805 5.625-5.475 5.92c.42.36.81 1.096.81 2.22c0 1.606-.015 2.896-.015 3.286c0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path></svg>
      </a>
      {showSidebar && <Button variant="ghost" shape="square" icon="menu" aria-label="Open navigation" data-menu-btn class="lg:hidden" />}
    </div>
  </div>
  <nav aria-label="Products" class="scrollbar-hide mx-auto flex h-12 w-full max-w-(--nb-shell-max) items-stretch gap-1 overflow-x-auto px-[calc(var(--nb-shell-gutter)-0.875rem)]">
    {tabs.map(([label, icon, href, sections, aside, badge], i) => {
      const active = sections.includes(section as never);
      const external = href.startsWith("http");
      const firstAside = aside && !tabs.slice(0, i).some((t) => t[4]);
      return (
        <a
          href={href}
          {...(external ? { target: "_blank", rel: "noopener" } : {})}
          aria-current={active ? "page" : undefined}
          class:list={["site-tab text-foreground relative flex shrink-0 items-center gap-2 px-3.5 text-sm font-medium no-underline transition-colors", firstAside && "ml-auto"]}
        >
          {!aside && <LucideIcon name={icon} class="size-4 opacity-90" />}{label}
          {badge && <Badge text={badge} variant="warning" class="ring-warning/30 -ml-1 px-1.5 font-semibold tracking-wide ring-1" />}
          {external && <LucideIcon name="arrow-up-right" class="size-3 opacity-60" />}
          {active && <span class="tab-indicator" aria-hidden="true"></span>}
        </a>
      );
    })}
  </nav>
</header>

<style>
  /* Solid at the top of the page; frosted glass once the reader scrolls. */
  .site-header {
    background: var(--nb-background);
    /* Always keep a hairline divider under the header. */
    border-bottom: 1px solid var(--nb-border);
    transition:
      background 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease,
      backdrop-filter 220ms ease;
  }
  .site-header[data-scrolled] {
    background: color-mix(in oklab, var(--nb-background) 70%, transparent);
    -webkit-backdrop-filter: saturate(180%) blur(18px);
    backdrop-filter: saturate(180%) blur(18px);
    /* Frosted glass on scroll — keep the divider, add only a faint lift. */
    box-shadow: 0 2px 6px -2px oklch(0 0 0 / 0.06);
  }

  /* Hover chip: a centred, rounded fill with breathing room around the label
   * (not a full-height block). A foreground tint keeps it clearly visible in
   * both light and dark themes, where --nb-accent is nearly invisible. */
  .site-tab {
    isolation: isolate;
  }
  .site-tab::before {
    content: "";
    position: absolute;
    inset-block: 0.375rem;
    inset-inline: 0;
    z-index: -1;
    border-radius: var(--nb-radius-control);
    background: transparent;
    transition: background 140ms ease;
  }
  .site-tab:hover::before {
    background: color-mix(in oklab, var(--nb-foreground) 7%, transparent);
  }
  /* Rounded accent underline for the active product tab (absolute → no layout shift). */
  .tab-indicator {
    position: absolute;
    inset-inline: 0.5rem;
    bottom: 0;
    height: 2px;
    background: var(--nb-primary);
  }
</style>

<script>
  // Toggle the frosted-glass state as the page scrolls. The listener lives on
  // the persistent `window`; the header element is re-queried each time so it
  // survives Astro view transitions without leaking duplicate listeners.
  if (!(window as unknown as { __whaleHeaderScroll?: boolean }).__whaleHeaderScroll) {
    (window as unknown as { __whaleHeaderScroll?: boolean }).__whaleHeaderScroll = true;
    const apply = () => {
      const header = document.querySelector("[data-nb-header]");
      if (header) header.toggleAttribute("data-scrolled", window.scrollY > 4);
    };
    window.addEventListener("scroll", apply, { passive: true });
    document.addEventListener("astro:page-load", apply);
    apply();
  }
</script>
