---
/**
 * Whale Docs header — this site's configuration of the theme's Header.
 *
 * Everything here is Longport Whale specific: the logo pair, the product tabs,
 * the three-locale switcher and the repository link. Markup, styles and the
 * scroll behaviour live in the theme.
 *
 * The two `aside` tabs pass no `icon`, which reproduces the previous
 * `{!aside && <LucideIcon …>}` behaviour now that the theme treats `icon` as
 * optional.
 */
import ThemeHeader from "@longbridge/astro-theme-docs/chrome/Header";
import { DocSearch } from "@longbridge/astro-theme-docs/ui/search";
import lightLogo from "../../../logo/whale-light.png";
import darkLogo from "../../../logo/whale-dark.png";

interface Props { showSidebar?: boolean }
const { showSidebar = true } = Astro.props;

const pathname = Astro.url.pathname;
const locale = pathname.startsWith("/zh-cn/") ? "zh-CN" : pathname.startsWith("/zh-hk/") ? "zh-HK" : "en";
const localePath = locale.toLowerCase();

// Keep the reader on the same page when switching language.
const suffix = pathname.replace(/^\/(en|zh-cn|zh-hk)(?=\/|$)/, "") || "/overview";
const languageOptions = [
  { label: "English", href: `/en${suffix}`, active: locale === "en" },
  { label: "简体中文", href: `/zh-cn${suffix}`, active: locale === "zh-CN" },
  { label: "繁體中文", href: `/zh-hk${suffix}`, active: locale === "zh-HK" },
];

// BrokerAPI is published while the platform capability is still being built:
// the reference is usable for integration planning, but endpoints and fields
// can still change. The tab carries a status marker so readers see that before
// they open the section. The marker stays untranslated in every locale so it
// remains short next to the tab label. See broker-api/overview for the full
// statement.
const previewBadge = "PRE";

// `aside: true` pins a tab to the right of the nav — external platforms and guides.
const tabs = [
  { label: "Docs", icon: "book-open", href: `/${localePath}/overview`, sections: ["docs", "overview", "design-system"] },
  { label: "WhaleSDK", icon: "package", href: `/${localePath}/whalesdk/overview`, sections: ["whalesdk"] },
  { label: "BrokerAPI", icon: "square-terminal", href: `/${localePath}/broker-api/overview`, sections: ["broker-api"], badge: previewBadge },
  { label: "TradingAPI", icon: "layers", href: `/${localePath}/trading-api/overview`, sections: ["trading-api"] },
  { label: "Whale Console", href: `/${localePath}/whale-console`, sections: ["whale-console"], aside: true },
  { label: "OpenAPI", href: "https://open.longportapp.com", sections: ["openapi"], aside: true },
];

// Locale occupies the first path segment, so the product section is the second.
const activeSection = pathname.split("/").filter(Boolean)[1] ?? "overview";
---

<ThemeHeader
  showSidebar={showSidebar}
  tabs={tabs}
  languageOptions={languageOptions}
  logoLightSrc={lightLogo.src}
  logoDarkSrc={darkLogo.src}
  logoHref={`/${localePath}/overview`}
  githubHref="https://github.com/longbridge/whale-docs"
  activeSection={activeSection}
>
  <DocSearch slot="search" />
</ThemeHeader>
