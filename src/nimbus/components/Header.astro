---
import { Icon } from "astro-icon/components";
import { Button } from "@/components/ui/button";
import { LinkButton } from "@/components/ui/link-button";
import { HeaderMenu } from "@components/HeaderMenu";
import lightLogo from "../../../logo/whale-light.png";

interface Props { showSidebar?: boolean }
const { showSidebar = true } = Astro.props;
const pathname = Astro.url.pathname;
const locale = pathname.startsWith("/zh-cn/") ? "zh-CN" : pathname.startsWith("/zh-hk/") ? "zh-HK" : "en";
const localePath = locale.toLowerCase();
const searchLabel = locale === "en" ? "Search documentation…" : locale === "zh-CN" ? "搜索…" : "搜尋…";
const suffix = pathname.replace(/^\/(en|zh-cn|zh-hk)(?=\/|$)/, "") || "/introduction/";
const languageOptions = [
  { label: "English", href: `/en${suffix}`, active: locale === "en" },
  { label: "简体中文", href: `/zh-cn${suffix}`, active: locale === "zh-CN" },
  { label: "繁體中文", href: `/zh-hk${suffix}`, active: locale === "zh-HK" },
];
const tabs = [
  ["Docs", "book-open", `/${localePath}/introduction/`, ["docs", "introduction", "design-system"]],
  ["Whale SDK", "device-mobile", `/${localePath}/whalesdk/overview/`, ["whalesdk"]],
  ["Broker API", "brackets-curly", `/${localePath}/broker-api/overview/`, ["broker-api"]],
  ["Trading API", "chart-line-up", `/${localePath}/trading-api/introduction/`, ["trading-api"]],
  ["OpenAPI", "plugs-connected", `/${localePath}/openapi/introduction/`, ["openapi"]],
] as const;
const section = pathname.split("/").filter(Boolean)[1] ?? "introduction";
---

<header class="bg-background/95 sticky top-0 z-30 border-b border-border/70 backdrop-blur-xl">
  <div class="mx-auto flex h-[4.5rem] items-center gap-5 px-(--nb-shell-gutter)">
    <a href={`/${localePath}/introduction/`} aria-label="Whale Docs" class="flex shrink-0 items-center no-underline">
      <img src={lightLogo.src} alt="Longport Whale" width="170" height="48" class="h-7 w-auto" />
    </a>
    <div><HeaderMenu client:load options={languageOptions} /></div>
    <button type="button" class="border-border text-muted-foreground hover:text-foreground mx-auto hidden h-9 w-full max-w-lg items-center gap-3 rounded-lg border bg-card px-4 text-sm shadow-sm md:flex" aria-label="Search documentation">
      <Icon name="ph:magnifying-glass" class="size-4" /><span>{searchLabel}</span><kbd class="ml-auto font-sans text-xs">⌘ K</kbd>
    </button>
    <div class="ml-auto flex items-center gap-1.5">
      <LinkButton href="https://github.com/longbridge/whale-docs" variant="ghost" shape="square" aria-label="GitHub" target="_blank" rel="noopener" class="hidden sm:inline-flex"><Icon name="ph:github-logo" class="size-4" /></LinkButton>
      <LinkButton href={`/${localePath}/docs/broker-onboarding/`} variant="primary" class="hidden sm:inline-flex">{locale === 'en' ? 'Get started' : locale === 'zh-CN' ? '快速开始' : '快速開始'}</LinkButton>
      {showSidebar && <Button variant="ghost" shape="square" icon="ph:list" aria-label="Open navigation" data-menu-btn class="lg:hidden" />}
    </div>
  </div>
  <nav aria-label="Products" class="whale-product-tabs flex h-12 items-stretch gap-1 overflow-x-auto px-(--nb-shell-gutter) [&>a:first-child]:pl-0 [&>a:first-child]:after:left-0">
    {tabs.map(([label, icon, href, sections]) => {
      const active = sections.includes(section as never);
      return <a href={href} aria-current={active ? 'page' : undefined} class:list={["relative flex shrink-0 items-center gap-2 px-3 text-sm font-medium no-underline transition-colors", active ? "text-foreground after:bg-primary after:absolute after:inset-x-2 after:bottom-0 after:h-0.5" : "text-muted-foreground hover:text-foreground"]}><Icon name={`ph:${icon}`} class="size-4" />{label}</a>;
    })}
  </nav>
</header>
