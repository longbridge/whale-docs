---
import { Icon } from "astro-icon/components";
import { Button } from "@/components/ui/button";
import { LinkButton } from "@/components/ui/link-button";
import { ThemeToggle } from "@/components/ui/theme-toggle";
import lightLogo from "../../../logo/whale-light.png";
import darkLogo from "../../../logo/whale-dark.png";

interface Props { showSidebar?: boolean }
const { showSidebar = true } = Astro.props;
const pathname = Astro.url.pathname;
const locale = pathname.startsWith("/zh-CN/") ? "zh-CN" : pathname.startsWith("/zh-HK/") ? "zh-HK" : "en";
const localeName = locale === "zh-CN" ? "简体中文" : locale === "zh-HK" ? "繁體中文" : "English";
const suffix = pathname.replace(/^\/(en|zh-CN|zh-HK)(?=\/|$)/, "") || "/introduction/";
const tabs = [
  ["Docs", "book-open", `/${locale}/introduction/`, ["docs", "introduction", "design-system"]],
  ["Whale SDK", "device-mobile", `/${locale}/whalesdk/overview/`, ["whalesdk"]],
  ["Broker API", "brackets-curly", `/${locale}/broker-api/overview/`, ["broker-api"]],
  ["Trading API", "chart-line-up", `/${locale}/trading-api/introduction/`, ["trading-api"]],
  ["OpenAPI", "plugs-connected", `/${locale}/openapi/introduction/`, ["openapi"]],
] as const;
const section = pathname.split("/").filter(Boolean)[1] ?? "introduction";
---

<header class="bg-background/95 sticky top-0 z-30 border-b border-border/70 backdrop-blur-xl">
  <div class="mx-auto flex h-[4.5rem] items-center gap-5 px-5 lg:px-8">
    <a href={`/${locale}/introduction/`} aria-label="Whale Docs" class="flex shrink-0 items-center no-underline">
      <img src={lightLogo.src} alt="Longport Whale" width="170" height="48" class="h-11 w-auto dark:hidden" />
      <img src={darkLogo.src} alt="Longport Whale" width="170" height="48" class="hidden h-11 w-auto dark:block" />
    </a>
    <details class="relative hidden sm:block">
      <summary class="text-muted-foreground hover:text-foreground flex cursor-pointer list-none items-center gap-1 rounded-md px-2 py-1 text-sm font-medium">
        {localeName}<Icon name="ph:caret-down" class="size-3.5" />
      </summary>
      <div class="bg-card border-border shadow-lg absolute top-full left-0 mt-2 min-w-36 rounded-lg border p-1.5">
        {[['en','English'],['zh-CN','简体中文'],['zh-HK','繁體中文']].map(([code,label]) => (
          <a href={`/${code}${suffix}`} class:list={["hover:bg-accent block rounded-md px-3 py-2 text-sm no-underline", code === locale && "bg-accent text-primary"]}>{label}</a>
        ))}
      </div>
    </details>
    <button type="button" class="border-border text-muted-foreground hover:text-foreground mx-auto hidden h-10 w-full max-w-xl items-center gap-3 rounded-xl border bg-card px-4 text-sm shadow-sm md:flex" aria-label="Search documentation">
      <Icon name="ph:magnifying-glass" class="size-4" /><span>Search documentation…</span><kbd class="ml-auto font-sans text-xs">⌘ K</kbd>
    </button>
    <div class="ml-auto flex items-center gap-1.5">
      <ThemeToggle />
      <LinkButton href="https://github.com/longbridge/whale-docs" variant="ghost" shape="square" aria-label="GitHub" target="_blank" rel="noopener"><Icon name="ph:github-logo" class="size-4" /></LinkButton>
      <LinkButton href={`/${locale}/docs/broker-onboarding/`} variant="primary" class="hidden sm:inline-flex">{locale === 'en' ? 'Get started' : locale === 'zh-CN' ? '快速开始' : '快速開始'}</LinkButton>
      {showSidebar && <Button variant="ghost" shape="square" icon="ph:list" aria-label="Open navigation" data-menu-btn class="lg:hidden" />}
    </div>
  </div>
  <nav aria-label="Products" class="whale-product-tabs flex h-12 items-stretch gap-1 overflow-x-auto px-5 lg:px-8">
    {tabs.map(([label, icon, href, sections]) => {
      const active = sections.includes(section as never);
      return <a href={href} aria-current={active ? 'page' : undefined} class:list={["relative flex shrink-0 items-center gap-2 px-3 text-sm font-medium no-underline transition-colors", active ? "text-foreground after:bg-primary after:absolute after:inset-x-2 after:bottom-0 after:h-0.5" : "text-muted-foreground hover:text-foreground"]}><Icon name={`ph:${icon}`} class="size-4" />{label}</a>;
    })}
  </nav>
</header>
