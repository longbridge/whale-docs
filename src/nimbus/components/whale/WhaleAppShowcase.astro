---
interface Props {
	marketLabel?: string;
	watchlistLabel?: string;
	assetsLabel?: string;
	newsLabel?: string;
	ariaLabel?: string;
}

const {
	marketLabel = "Market",
	watchlistLabel = "Watchlist",
	assetsLabel = "Assets",
	newsLabel = "News",
	ariaLabel = "WhaleApp SDK screen examples",
} = Astro.props;

const screens = [
	{ id: "market", label: marketLabel, src: "/images/whalesdk/screenshot-market.png" },
	{ id: "watchlist", label: watchlistLabel, src: "/images/whalesdk/screenshot-watchlist.png" },
	{ id: "assets", label: assetsLabel, src: "/images/whalesdk/screenshot-assets.png" },
	{ id: "news", label: newsLabel, src: "/images/whalesdk/screenshot-news.png" },
];
---

<div class="whale-showcase" data-whale-showcase aria-label={ariaLabel}>
	<div class="device-stage">
		<div class="device" aria-live="polite">
			<div class="device-bezel">
				<div class="dynamic-island" aria-hidden="true">
					<span class="camera"></span>
				</div>
				<div class="screen">
					{screens.map((screen, index) => (
						<img
							src={screen.src}
							alt={`${screen.label} — WhaleApp SDK`}
							class:list={["screen-image", { active: index === 0 }]}
							data-screen={screen.id}
							loading={index === 0 ? "eager" : "lazy"}
						/>
					))}
				</div>
				<div class="home-indicator" aria-hidden="true"></div>
			</div>
		</div>
	</div>

	<div class="screen-picker" role="tablist" aria-label={ariaLabel}>
		{screens.map((screen, index) => (
			<button
				type="button"
				role="tab"
				aria-selected={index === 0 ? "true" : "false"}
				tabindex={index === 0 ? 0 : -1}
				data-target={screen.id}
				class:list={{ active: index === 0 }}
			>
				<span class="picker-dot" aria-hidden="true"></span>
				{screen.label}
			</button>
		))}
	</div>
</div>

<script>
	document.querySelectorAll<HTMLElement>("[data-whale-showcase]").forEach((showcase) => {
		const tabs = Array.from(showcase.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
		const images = Array.from(showcase.querySelectorAll<HTMLElement>("[data-screen]"));

		const select = (tab: HTMLButtonElement) => {
			const target = tab.dataset.target;
			tabs.forEach((item) => {
				const active = item === tab;
				item.classList.toggle("active", active);
				item.setAttribute("aria-selected", String(active));
				item.tabIndex = active ? 0 : -1;
			});
			images.forEach((image) => image.classList.toggle("active", image.dataset.screen === target));
		};

		tabs.forEach((tab, index) => {
			tab.addEventListener("click", () => select(tab));
			tab.addEventListener("keydown", (event) => {
				if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
				event.preventDefault();
				let next = index;
				if (event.key === "ArrowLeft") next = (index - 1 + tabs.length) % tabs.length;
				if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
				if (event.key === "Home") next = 0;
				if (event.key === "End") next = tabs.length - 1;
				select(tabs[next]);
				tabs[next].focus();
			});
		});
	});
</script>

<style>
	.whale-showcase {
		--device-width: min(280px, calc(100vw - 4.5rem));
		display: grid;
		justify-items: center;
		gap: 1.4rem;
		margin: 2rem 0;
	}

	.device-stage {
		position: relative;
		display: grid;
		place-items: center;
		padding: 1rem 2.4rem 1.4rem;
		isolation: isolate;
	}

	.device-stage::before {
		position: absolute;
		z-index: -1;
		width: 21rem;
		height: 21rem;
		max-width: 84vw;
		max-height: 84vw;
		border-radius: 999px;
		background:
			radial-gradient(circle at 50% 48%, rgb(93 50 220 / 18%), rgb(93 50 220 / 5%) 48%, transparent 72%);
		content: "";
		filter: blur(8px);
	}

	.device {
		position: relative;
		width: var(--device-width);
		aspect-ratio: 280 / 574;
		border: 1px solid rgb(255 255 255 / 28%);
		border-radius: calc(var(--device-width) * 0.15);
		background: linear-gradient(145deg, #4e4d54 0%, #121217 19%, #050507 73%, #35343b 100%);
		padding: calc(var(--device-width) * 0.035);
		box-shadow:
			0 2.2rem 4.5rem rgb(8 7 15 / 28%),
			0 0.45rem 1.2rem rgb(8 7 15 / 24%),
			inset 0 0 0 1px rgb(0 0 0 / 72%);
	}

	.device::before,
	.device::after {
		position: absolute;
		left: -3px;
		width: 3px;
		border-radius: 2px 0 0 2px;
		background: #242329;
		content: "";
	}

	.device::before {
		top: 22%;
		height: 10%;
		box-shadow: 0 calc(var(--device-width) * 0.135) 0 #242329;
	}

	.device::after {
		top: 13%;
		height: 5%;
	}

	.device-bezel,
	.screen {
		width: 100%;
		height: 100%;
		border-radius: calc(var(--device-width) * 0.12);
	}

	.device-bezel {
		position: relative;
		overflow: hidden;
		background: #050506;
	}

	.screen {
		position: relative;
		overflow: hidden;
		background: #f7f7f9;
	}

	.screen-image {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		opacity: 0;
		transition: opacity 180ms ease;
	}

	.screen-image.active {
		opacity: 1;
	}

	.dynamic-island {
		position: absolute;
		z-index: 2;
		top: 1.5%;
		left: 50%;
		width: 31%;
		height: 4.8%;
		transform: translateX(-50%);
		border-radius: 999px;
		background: #050506;
		box-shadow: 0 1px 2px rgb(255 255 255 / 8%);
	}

	.camera {
		position: absolute;
		top: 50%;
		right: 10%;
		width: 8%;
		aspect-ratio: 1;
		transform: translateY(-50%);
		border-radius: 50%;
		background: radial-gradient(circle at 35% 35%, #263b67, #091020 58%, #000 72%);
	}

	.home-indicator {
		position: absolute;
		z-index: 2;
		bottom: 1.1%;
		left: 50%;
		width: 34%;
		height: 0.75%;
		transform: translateX(-50%);
		border-radius: 999px;
		background: rgb(10 10 12 / 86%);
	}

	.screen-picker {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.45rem;
	}

	.screen-picker button {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		min-height: 2.25rem;
		border: 1px solid var(--sl-color-gray-5, #d9d9df);
		border-radius: 999px;
		background: transparent;
		padding: 0.45rem 0.8rem;
		color: inherit;
		font: inherit;
		font-size: 0.82rem;
		font-weight: 600;
		cursor: pointer;
		transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease;
	}

	.screen-picker button:hover {
		border-color: #7c5ce0;
	}

	.screen-picker button:focus-visible {
		outline: 2px solid #7556d8;
		outline-offset: 2px;
	}

	.screen-picker button.active {
		border-color: rgb(104 70 207 / 45%);
		background: rgb(104 70 207 / 10%);
		color: #6444c8;
	}

	.picker-dot {
		width: 0.42rem;
		height: 0.42rem;
		border-radius: 50%;
		background: currentColor;
		opacity: 0.45;
	}

	.screen-picker button.active .picker-dot {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.screen-image,
		.screen-picker button {
			transition: none;
		}
	}
</style>
