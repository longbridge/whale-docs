---
import {
  ChartNoAxesCombined,
  ChevronRight,
  Code2,
  Database,
  HardDrive,
  FilePenLine,
  KeyRound,
  Link,
  Plug,
  Puzzle,
  RefreshCw,
  Smartphone,
  Users,
} from "lucide-astro";
import { Card, CardAction, CardContent, CardHeader, CardTitle } from "@components/components/ui/card";
import { cn } from "@components/lib/utils";

interface Props { title: string; href?: string; icon?: string; class?: string }
const { title, href, icon, class: className } = Astro.props;
const hasContent = Astro.slots.has("default");
const icons: Record<string, typeof Smartphone> = {
  smartphone: Smartphone,
  mobile: Smartphone,
  server: HardDrive,
  database: Database,
  plug: Plug,
  code: Code2,
  users: Users,
  key: KeyRound,
  link: Link,
  "file-pen": FilePenLine,
  rotate: RefreshCw,
  "chart-candlestick": ChartNoAxesCombined,
};
const CardIcon = icons[icon ?? ""] ?? Puzzle;
---

<Card className={cn("doc-product-card relative my-0 h-full transition-colors", href && "hover:bg-muted/30", className)}>
  <CardHeader>
    <span class="doc-product-card-icon"><CardIcon aria-hidden="true" size={18} strokeWidth={1.8} /></span>
    <CardTitle>
      {href ? <a href={href} class="doc-product-card-link">{title}</a> : title}
    </CardTitle>
    {href && <CardAction><ChevronRight aria-hidden="true" size={16} /></CardAction>}
  </CardHeader>
  {hasContent && <CardContent className="doc-product-card-content"><slot /></CardContent>}
</Card>
