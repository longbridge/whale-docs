---
import {
  ChartNoAxesCombined,
  ChevronRight,
  Code2,
  Database,
  HardDrive,
  KeyRound,
  Link,
  Plug,
  Puzzle,
  Smartphone,
  Users,
} from "lucide-astro";
import { Card, CardAction, CardContent, CardHeader, CardTitle } from "@components/components/ui/card";

interface Props { title: string; href?: string; icon?: string }
const { title, href, icon } = Astro.props;
const icons: Record<string, typeof Smartphone> = {
  smartphone: Smartphone,
  mobile: Smartphone,
  server: HardDrive,
  database: Database,
  plug: Plug,
  code: Code2,
  users: Users,
  key: KeyRound,
  link: Link,
  "chart-candlestick": ChartNoAxesCombined,
};
const CardIcon = icons[icon ?? ""] ?? Puzzle;
---

<Card className="doc-product-card relative my-0 h-full transition-colors hover:bg-muted/30">
  <CardHeader>
    <span class="doc-product-card-icon"><CardIcon aria-hidden="true" size={18} strokeWidth={1.8} /></span>
    <CardTitle>
      {href ? <a href={href} class="doc-product-card-link">{title}</a> : title}
    </CardTitle>
    {href && <CardAction><ChevronRight aria-hidden="true" size={16} /></CardAction>}
  </CardHeader>
  <CardContent className="doc-product-card-content"><slot /></CardContent>
</Card>
