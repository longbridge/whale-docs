---
import Card from "../ui/card/Card.astro";

interface Props { title: string; href?: string; icon?: string }
const { title, href, icon } = Astro.props;
const icons: Record<string, string> = {
  smartphone: "ph:device-mobile",
  mobile: "ph:device-mobile",
  server: "ph:hard-drives",
  database: "ph:database",
  plug: "ph:plug",
  code: "ph:code",
  users: "ph:users",
  key: "ph:key",
  link: "ph:link",
  "chart-candlestick": "ph:chart-line-up",
  "circle-check": "ph:check-circle",
  "badge-check": "ph:seal-check",
  "triangle-exclamation": "ph:warning",
};
---
<Card title={title} href={href} icon={icons[icon ?? ""] ?? "ph:puzzle-piece"} class="group/card"><slot /></Card>
