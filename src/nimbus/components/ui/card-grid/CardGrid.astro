---
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
	cols?: 1 | 2 | 3 | 4;
}

const { cols = 2, class: className, ...attrs } = Astro.props;
const columns = {
	1: "sm:grid-cols-1",
	2: "sm:grid-cols-2",
	3: "sm:grid-cols-2 xl:grid-cols-3",
	4: "sm:grid-cols-2 xl:grid-cols-4",
}[cols];
---

<div
	class={cn(
		"my-4 grid grid-cols-1 gap-4 [&>*]:my-0!",
		columns,
		className,
	)}
	{...attrs}
>
	<slot />
</div>
