---
import { Icon } from "astro-icon/components";
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";
import { PageActionsMenu } from "@components/PageActionsMenu";

interface Props extends HTMLAttributes<"div"> { lastUpdated?: Date }
const { class: className, ...attrs } = Astro.props;
const locale = Astro.url.pathname.startsWith("/zh-CN/") ? "zh-CN" : Astro.url.pathname.startsWith("/zh-HK/") ? "zh-HK" : "en";
const copyLabel = locale === "en" ? "Copy page" : locale === "zh-CN" ? "复制页面" : "複製頁面";
---

<div data-nb-page-actions class={cn("not-prose flex items-center", className)} {...attrs}>
  <button type="button" data-nb-page-actions-copy class="border-border hover:bg-accent inline-flex h-8 cursor-pointer items-center gap-1.5 rounded-l-md border bg-card px-2.5 text-[0.8125rem] font-medium transition-colors" aria-label="Copy page as Markdown">
    <Icon name="ph:copy" class="size-3.5" data-nb-page-actions-copy-icon />
    <Icon name="ph:check-circle" class="text-success hidden size-3.5" data-nb-page-actions-check-icon />
    <span data-nb-page-actions-label aria-live="polite">{copyLabel}</span>
  </button>
  <PageActionsMenu client:load locale={locale} />
</div>

<script>
  import "./page-actions.client";
</script>
