---
import lightLogo from "../../../logo/whale-light.png";
import { Icon } from "astro-icon/components";
const year = new Date().getFullYear();
const pathname = Astro.url.pathname;
const locale = pathname.startsWith("/zh-cn/") ? "zh-cn" : pathname.startsWith("/zh-hk/") ? "zh-hk" : "en";
---
<footer id="footer" class="border-border mt-auto flex w-full flex-col items-center border-t">
  <div class="z-20 flex w-full max-w-[984px] flex-col gap-12 px-8 py-16 md:py-20 lg:py-28">
    <div class="flex min-h-[76px] flex-col justify-between gap-8 md:flex-row">
      <div class="flex min-w-20 items-start justify-between md:min-w-48 md:flex-col">
        <a href="https://longportwhale.com" target="_blank" rel="noreferrer" aria-label="Longport Whale">
          <img src={lightLogo.src} alt="Longport Whale" class="h-[26px] w-auto max-w-48 object-contain" />
        </a>
      </div>
      <div class="grid flex-1 grid-cols-2 gap-8">
        <div class="flex justify-start md:justify-center">
          <div class="flex flex-col gap-4 text-sm">
            <h2 class="mb-1 font-semibold">Products</h2>
            <a class="text-muted-foreground hover:text-foreground" href={`/${locale}/whalesdk/overview/`}>Whale SDK</a>
            <a class="text-muted-foreground hover:text-foreground" href={`/${locale}/broker-api/overview/`}>Broker API</a>
            <a class="text-muted-foreground hover:text-foreground" href="https://open.longportapp.com" target="_blank" rel="noreferrer">OpenAPI</a>
          </div>
        </div>
        <div class="flex justify-start md:justify-center">
          <div class="flex flex-col gap-4 text-sm">
            <h2 class="mb-1 font-semibold">Company</h2>
            <a class="text-muted-foreground hover:text-foreground" href="https://longportwhale.com" target="_blank" rel="noreferrer">Longport Whale</a>
          </div>
        </div>
      </div>
      <div class="hidden min-w-20 justify-end md:flex md:min-w-48">
        <a class="text-muted-foreground hover:text-foreground h-fit" href="https://longportwhale.com" target="_blank" rel="noreferrer" aria-label="Longport Whale website"><Icon name="ph:globe-hemisphere-west" class="size-5" /></a>
      </div>
    </div>
    <div class="bg-border h-px w-full"></div>
    <div class="text-muted-foreground flex items-center justify-between text-sm">
      <span>© {year} Longport. All rights reserved.</span>
      <a class="hover:text-foreground md:hidden" href="https://longportwhale.com" target="_blank" rel="noreferrer" aria-label="Longport Whale website"><Icon name="ph:globe-hemisphere-west" class="size-5" /></a>
    </div>
  </div>
</footer>
