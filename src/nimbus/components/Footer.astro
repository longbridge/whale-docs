---
import lightLogo from "../../../logo/whale-light.png";
import darkLogo from "../../../logo/whale-dark.png";
import { Icon } from "astro-icon/components";
import LucideIcon from "@theme/components/ui/icon/LucideIcon.astro";
const year = new Date().getFullYear();
const pathname = Astro.url.pathname;
const locale = pathname.startsWith("/zh-cn/") ? "zh-cn" : pathname.startsWith("/zh-hk/") ? "zh-hk" : "en";
---
<footer id="footer" class="border-border mt-auto flex w-full flex-col items-center border-t">
  <div class="z-20 flex w-full flex-col gap-12 px-(--nb-shell-gutter) py-16 md:py-20 lg:py-28">
    <div class="flex flex-col justify-between gap-12 md:flex-row">
      <!-- Brand + contact, anchored bottom-left -->
      <div class="flex flex-col justify-between gap-10 md:min-w-56">
        <a href="https://longportwhale.com" target="_blank" rel="noreferrer" aria-label="Longport Whale" class="w-fit">
          <img src={lightLogo.src} alt="Longport Whale" class="logo-light h-[26px] w-auto max-w-48 object-contain" />
          <img src={darkLogo.src} alt="Longport Whale" class="logo-dark h-[26px] w-auto max-w-48 object-contain" />
        </a>
        <div class="text-muted-foreground flex flex-col gap-2 text-sm">
          <a class="hover:text-foreground w-fit" href="tel:+85236116691">+852 3611 6691</a>
          <a class="hover:text-foreground w-fit" href="tel:+85236116692">+852 3611 6692</a>
          <a class="hover:text-foreground w-fit" href="mailto:bd@longportwhale.com">bd@longportwhale.com</a>
        </div>
      </div>
      <!-- Link columns: the footer's primary navigation -->
      <div class="grid grid-cols-2 gap-8 sm:flex sm:gap-16">
        <div class="flex flex-col gap-4 text-sm">
          <h2 class="mb-1 font-semibold">Products</h2>
          <a class="text-muted-foreground hover:text-foreground" href={`/${locale}/whalesdk/overview`}>WhaleSDK</a>
          <a class="text-muted-foreground hover:text-foreground" href={`/${locale}/broker-api/overview`}>BrokerAPI</a>
          <a class="text-muted-foreground hover:text-foreground" href="https://open.longportapp.com" target="_blank" rel="noreferrer">OpenAPI</a>
        </div>
        <div class="flex flex-col gap-4 text-sm">
          <h2 class="mb-1 font-semibold">Company</h2>
          <a class="text-muted-foreground hover:text-foreground" href="https://longportwhale.com" target="_blank" rel="noreferrer">Longport Whale</a>
          <a class="text-muted-foreground hover:text-foreground" href="https://longportwhale.com/about" target="_blank" rel="noreferrer">About Us</a>
          <a class="text-muted-foreground hover:text-foreground" href="https://longportwhale.com/jobs" target="_blank" rel="noreferrer">Careers</a>
        </div>
        <div class="flex flex-col gap-4 text-sm">
          <h2 class="mb-1 font-semibold">Consulting</h2>
          <a class="text-muted-foreground hover:text-foreground" href="#">Solutions</a>
          <a class="text-muted-foreground hover:text-foreground" href="#">Features</a>
        </div>
      </div>
    </div>
    <div class="border-border text-muted-foreground flex flex-col-reverse items-start gap-4 border-t pt-8 text-sm md:flex-row md:items-center md:justify-between">
      <span>© {year} LONGPORT WHALE. All rights reserved.</span>
      <div class="flex items-center gap-4">
        <a class="hover:text-foreground" href="https://assets.lbctrl.com/uploads/e664248a-9125-4fd5-b759-6ce44ee3c3ad/cb87ebde700e0c715e8e86bfce6e187b.pdf" target="_blank" rel="noreferrer">Privacy Policy</a>
        <a class="hover:text-foreground" href="https://assets.lbctrl.com/uploads/68304bf1-c50f-47f6-b454-2e89fbb5e9b1/e611db04da5788bdb2c30352be0ff15e.pdf" target="_blank" rel="noreferrer">Legal Terms</a>
        <a class="hover:text-foreground" href="https://longportwhale.com" target="_blank" rel="noreferrer" aria-label="Longport Whale website"><LucideIcon name="globe" class="size-5" /></a>
        <a class="hover:text-foreground" href="https://www.linkedin.com/company/longbridgewhale" target="_blank" rel="noreferrer" aria-label="Longport Whale LinkedIn"><Icon name="simple-icons:linkedin" class="size-5" /></a>
      </div>
    </div>
  </div>
</footer>
