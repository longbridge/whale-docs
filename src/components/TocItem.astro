---
type TocEntry = { slug: string; text: string; children?: TocEntry[] };
interface Props { item: TocEntry }
const { item } = Astro.props;
---
<li>
  <a href={`#${item.slug}`} data-toc-link>{item.text}</a>
  {item.children && item.children.length > 0 && <ul>{item.children.map((child) => <Astro.self item={child} />)}</ul>}
</li>
