---
import { Menu, X } from 'lucide-astro';
const locale = Astro.url.pathname.split('/')[1] || 'en';
const labels = locale === 'en'
  ? { open: 'Open navigation', close: 'Close navigation' }
  : locale === 'zh-cn'
    ? { open: '打开导航', close: '关闭导航' }
    : { open: '開啟導覽', close: '關閉導覽' };
---

<button class="whale-menu-toggle" type="button" aria-label={labels.open} aria-controls="starlight__sidebar" aria-expanded="false" data-whale-menu data-open-label={labels.open} data-close-label={labels.close}>
  <Menu class="menu-open" size={18} aria-hidden="true" />
  <X class="menu-close" size={18} aria-hidden="true" />
</button>

<script>
  const setupMenu = () => {
    const button = document.querySelector<HTMLButtonElement>('[data-whale-menu]');
    const sidebar = document.querySelector<HTMLElement>('#starlight__sidebar');
    if (!button || !sidebar || button.dataset.ready) return;
    button.dataset.ready = 'true';
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? button.dataset.closeLabel ?? '' : button.dataset.openLabel ?? '');
    };
    const close = () => setOpen(false);
    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    sidebar.addEventListener('click', (event) => { if ((event.target as HTMLElement).closest('a')) close(); });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || button.getAttribute('aria-expanded') !== 'true') return;
      close();
      button.focus();
    });
  };
  document.addEventListener('astro:page-load', setupMenu);
  setupMenu();
</script>

<style>
  .whale-menu-toggle {
    position: fixed;
    z-index: 30;
    inset: 1.25rem 1rem auto auto;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    color: var(--nb-muted-foreground);
    border: 1px solid var(--nb-border);
    border-radius: var(--nb-radius-control);
    background: var(--nb-card);
  }
  .menu-close, [aria-expanded='true'] .menu-open { display: none; }
  [aria-expanded='true'] .menu-close { display: block; }
  @media (min-width: 50rem) { .whale-menu-toggle { display: none; } }
</style>
