---
import Search from '@astrojs/starlight/components/Search.astro';
import { BookOpen, Braces, ChartNoAxesCombined, ChevronRight, ExternalLink, Plug, Smartphone } from 'lucide-astro';
import { HeaderMenu } from './HeaderMenu';

const path = Astro.url.pathname;
const locale = path.split('/')[1] || 'en';
const localHref = (slug: string) => `/${locale}/${slug}/`;
const labels = locale === 'en'
  ? { products: 'Products', table: 'Scrollable table', language: 'Language', appearance: 'Appearance', auto: 'System', light: 'Light', dark: 'Dark' }
  : locale === 'zh-cn'
    ? { products: '产品', table: '可横向滚动的表格', language: '语言', appearance: '外观', auto: '跟随系统', light: '浅色', dark: '深色' }
    : { products: '產品', table: '可橫向捲動的表格', language: '語言', appearance: '外觀', auto: '跟隨系統', light: '淺色', dark: '深色' };
const localeOptions = [
  { code: 'en', label: 'English' },
  { code: 'zh-cn', label: '简体中文' },
  { code: 'zh-hk', label: '繁體中文' },
].map(({ code, label }) => ({
  label,
  active: code === locale,
  href: path.replace(/^\/(en|zh-cn|zh-hk)(?=\/)/, `/${code}`),
}));
const tabs = [
  { label: 'Docs', href: localHref('introduction'), icon: BookOpen, active: path.includes(`/${locale}/docs/`) || path === `/${locale}/introduction/` || path.includes(`/${locale}/design-system/`) },
  { label: 'Whale SDK', href: localHref('whalesdk/overview'), icon: Smartphone, active: path.includes(`/${locale}/whalesdk/`) },
  { label: 'Broker API', href: localHref('broker-api/overview'), icon: Braces, active: path.includes(`/${locale}/broker-api/`) },
  { label: 'Trading API', href: localHref('trading-api/introduction'), icon: ChartNoAxesCombined, active: path.includes(`/${locale}/trading-api/`) },
  { label: 'OpenAPI', href: 'https://open.longportapp.com', icon: Plug, active: false, external: true },
];
---
<header class="whale-header">
  <div class="whale-header-main">
    <div class="whale-site-cluster">
      <a class="whale-brand" href={localHref('introduction')} aria-label="Whale Docs">
        <img class="whale-brand-light" src="/logo/whale-light.png" alt="Whale" width="170" height="40" />
        <img class="whale-brand-dark" src="/logo/whale-dark.png" alt="" width="170" height="40" />
      </a>
      <HeaderMenu client:load kind="language" label={labels.language} options={localeOptions} />
    </div>
    <div class="whale-search"><Search /></div>
    <div class="whale-header-actions">
      <a class="whale-quickstart" href={localHref('docs/broker-onboarding')}>{locale === 'en' ? 'Quickstart' : locale === 'zh-cn' ? '快速开始' : '快速開始'} <ChevronRight size={14} aria-hidden="true" /></a>
      <HeaderMenu client:load kind="appearance" label={labels.appearance} autoLabel={labels.auto} lightLabel={labels.light} darkLabel={labels.dark} />
    </div>
  </div>
  <nav class="whale-product-tabs" aria-label={labels.products}>
    {tabs.map((tab) => {
      const TabIcon = tab.icon;
      return (
        <a href={tab.href} class:list={{ active: tab.active }} aria-current={tab.active ? 'page' : undefined} target={tab.external ? '_blank' : undefined} rel={tab.external ? 'noreferrer' : undefined}>
          <TabIcon size={15} strokeWidth={1.8} aria-hidden="true" />{tab.label}{tab.external && <ExternalLink size={12} aria-hidden="true" />}
        </a>
      );
    })}
  </nav>
</header>
<script>
  const wrapWideTables = () => {
    for (const table of document.querySelectorAll<HTMLTableElement>('.sl-markdown-content table:not([class])')) {
      if (table.parentElement?.classList.contains('whale-table-scroll')) continue;
      const wrapper = document.createElement('div');
      wrapper.className = 'whale-table-scroll';
      wrapper.tabIndex = 0;
      wrapper.setAttribute('role', 'region');
    wrapper.setAttribute('aria-label', document.documentElement.lang === 'en' ? 'Scrollable table' : document.documentElement.lang === 'zh-HK' ? '可橫向捲動的表格' : '可横向滚动的表格');
      table.parentNode?.insertBefore(wrapper, table);
      wrapper.appendChild(table);
    }
  };

  document.addEventListener('astro:page-load', wrapWideTables);
  wrapWideTables();
</script>
