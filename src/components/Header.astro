---
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import { BookOpen, Braces, ChartNoAxesCombined, Plug, Smartphone } from 'lucide-astro';

const path = Astro.url.pathname;
const locale = path.split('/')[1] || 'en';
const tabs = [
  { label: 'Docs', href: `/${locale}/introduction`, icon: BookOpen, active: path.includes(`/${locale}/docs/`) || path === `/${locale}/introduction/` || path.includes(`/${locale}/design-system/`) },
  { label: 'Whale SDK', href: `/${locale}/whalesdk/overview`, icon: Smartphone, active: path.includes(`/${locale}/whalesdk/`) },
  { label: 'Broker API', href: `/${locale}/broker-api/overview`, icon: Braces, active: path.includes(`/${locale}/broker-api/`) },
  { label: 'Trading API', href: `/${locale}/trading-api/introduction`, icon: ChartNoAxesCombined, active: path.includes(`/${locale}/trading-api/`) },
  { label: 'OpenAPI', href: 'https://open.longportapp.com', icon: Plug, active: false, external: true },
];
---
<header class="whale-header">
  <div class="whale-header-main">
    <div class="whale-site-cluster"><div class="whale-site-title"><SiteTitle /></div><LanguageSelect /></div>
    <div class="whale-search"><Search /></div>
    <div class="whale-header-actions">
      <a class="whale-quickstart" href={`/${locale}/docs/broker-onboarding`}>{locale === 'en' ? 'Quickstart' : locale === 'zh-cn' ? '快速开始' : '快速開始'} <span aria-hidden="true">›</span></a>
      <ThemeSelect />
    </div>
  </div>
  <nav class="whale-product-tabs" aria-label="Products">
    {tabs.map((tab) => {
      const TabIcon = tab.icon;
      return (
        <a href={tab.href} class:list={{ active: tab.active }} target={tab.external ? '_blank' : undefined} rel={tab.external ? 'noreferrer' : undefined}>
          <TabIcon size={15} strokeWidth={1.8} aria-hidden="true" />{tab.label}{tab.external && <span aria-hidden="true">↗</span>}
        </a>
      );
    })}
  </nav>
</header>
<script>
  const wrapWideTables = () => {
    for (const table of document.querySelectorAll<HTMLTableElement>('.sl-markdown-content table:not([class])')) {
      if (table.parentElement?.classList.contains('whale-table-scroll')) continue;
      const wrapper = document.createElement('div');
      wrapper.className = 'whale-table-scroll';
      wrapper.tabIndex = 0;
      wrapper.setAttribute('role', 'region');
      wrapper.setAttribute('aria-label', 'Scrollable table');
      table.parentNode?.insertBefore(wrapper, table);
      wrapper.appendChild(table);
    }
  };

  document.addEventListener('astro:page-load', wrapWideTables);
  wrapWideTables();
</script>
