---
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';

const { sidebar } = Astro.locals.starlightRoute;
const pathname = Astro.url.pathname;
const locale = pathname.split('/')[1] || 'en';

const productIndex = pathname.includes(`/${locale}/whalesdk/`)
  ? 1
  : pathname.includes(`/${locale}/broker-api/`)
    ? 2
    : pathname.includes(`/${locale}/trading-api/`)
      ? 3
      : 0;

const activeProduct = sidebar[productIndex];
const selected = activeProduct?.type === 'group'
  ? activeProduct.entries
  : activeProduct
    ? [activeProduct]
    : sidebar;

const belongsToLocale = (entry: (typeof selected)[number]): boolean => {
  if (entry.type === 'link') return !entry.href.startsWith('/') || entry.href.startsWith(`/${locale}/`);
  return entry.entries.some(belongsToLocale);
};

const filterLocale = (entry: (typeof selected)[number]): (typeof selected)[number] | undefined => {
  if (entry.type === 'link') return belongsToLocale(entry) ? entry : undefined;
  const entries = entry.entries.flatMap((child) => {
    const filtered = filterLocale(child);
    return filtered ? [filtered] : [];
  });
  return entries.length > 0 ? { ...entry, entries } : undefined;
};

const localizedSidebar = selected.flatMap((entry) => {
  const filtered = filterLocale(entry);
  return filtered ? [filtered] : [];
});
---
<SidebarPersister>
  <SidebarSublist sublist={localizedSidebar} />
</SidebarPersister>
<div class="md:sl-hidden"><MobileMenuFooter /></div>
