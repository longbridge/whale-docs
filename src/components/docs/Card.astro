---
import {
  BadgeCheck,
  ChartCandlestick,
  CircleCheck,
  Code,
  Database,
  FilePen,
  KeyRound,
  Link as LinkIcon,
  Palette,
  Plug,
  Puzzle,
  RotateCw,
  Ruler,
  Server,
  Shapes,
  SlidersHorizontal,
  Smartphone,
  TriangleAlert,
  Type,
  Users,
  ArrowRight,
} from 'lucide-astro';
import { Card as ReuiCard, CardAction, CardDescription, CardHeader, CardTitle } from '../components/ui/card';

interface Props { title: string; href?: string; icon?: string }
const { title, href, icon } = Astro.props;
const icons = {
  'badge-check': BadgeCheck,
  'chart-candlestick': ChartCandlestick,
  'circle-check': CircleCheck,
  code: Code,
  database: Database,
  'file-pen': FilePen,
  key: KeyRound,
  link: LinkIcon,
  mobile: Smartphone,
  palette: Palette,
  plug: Plug,
  rotate: RotateCw,
  ruler: Ruler,
  server: Server,
  shapes: Shapes,
  sliders: SlidersHorizontal,
  smartphone: Smartphone,
  'triangle-exclamation': TriangleAlert,
  type: Type,
  users: Users,
} as const;
const CardIcon = icons[icon as keyof typeof icons] ?? Puzzle;
---
{href ? <a class="whale-card-link" href={href}>
  <ReuiCard className="whale-card gap-0 py-0">
    <CardHeader className="grid grid-cols-[auto_minmax(0,1fr)_auto] grid-rows-[auto_auto] gap-x-3 gap-y-1 p-4">
      <span class="whale-card-icon" aria-hidden="true"><CardIcon size={19} strokeWidth={1.8} /></span>
      <CardTitle className="col-start-2 text-sm font-semibold text-foreground">{title}</CardTitle>
      <CardDescription className="col-start-2 text-sm leading-6"><slot /></CardDescription>
      <CardAction className="col-start-3 row-span-2 row-start-1"><ArrowRight class="whale-card-arrow" size={16} strokeWidth={1.8} aria-hidden="true" /></CardAction>
    </CardHeader>
  </ReuiCard>
</a> : <ReuiCard className="whale-card gap-0 py-0">
  <CardHeader className="grid grid-cols-[auto_minmax(0,1fr)] grid-rows-[auto_auto] gap-x-3 gap-y-1 p-4">
    <span class="whale-card-icon" aria-hidden="true"><CardIcon size={19} strokeWidth={1.8} /></span>
    <CardTitle className="col-start-2 text-sm font-semibold text-foreground">{title}</CardTitle>
    <CardDescription className="col-start-2 text-sm leading-6"><slot /></CardDescription>
  </CardHeader>
</ReuiCard>}
