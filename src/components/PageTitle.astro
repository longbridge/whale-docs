---
const { entry } = Astro.locals.starlightRoute;
const path = Astro.url.pathname;
const locale = path.split('/')[1] || 'en';
const product = path.includes('/whalesdk/')
  ? 'WhaleApp SDK'
  : path.includes('/broker-api/')
    ? 'Broker API'
    : path.includes('/trading-api/')
      ? 'Trading API'
      : locale === 'en'
        ? 'Docs'
        : locale === 'zh-cn'
          ? '指南'
          : '指南';
---

<div class="whale-page-heading">
  <div class="whale-page-kicker">{product}</div>
  <div class="whale-heading-row">
    <h1 id="_top">{entry.data.title}</h1>
    <button class="whale-copy-page" type="button" data-copy-page>
      <span aria-hidden="true">▣</span>
      {locale === 'en' ? 'Copy page' : locale === 'zh-cn' ? '复制页面' : '複製頁面'}
    </button>
  </div>
  {entry.data.description && <p>{entry.data.description}</p>}
</div>

<script>
  document.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-copy-page]');
    if (!button) return;
    await navigator.clipboard.writeText(window.location.href);
    button.dataset.copied = 'true';
    window.setTimeout(() => delete button.dataset.copied, 900);
  });
</script>

<style>
  .whale-page-heading {
    display: grid;
    gap: 0.15rem;
  }

  .whale-page-heading > * {
    margin: 0;
  }

  .whale-heading-row {
    display: flex;
    gap: 1rem;
    align-items: start;
    justify-content: space-between;
  }

  h1 {
    color: var(--sl-color-white);
    font-size: 2.25rem;
    line-height: 1.15;
    letter-spacing: -0.028em;
  }

  .whale-copy-page {
    flex: none;
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    margin-top: 0.25rem;
    min-width: 8.75rem;
    justify-content: center;
    padding: 0.45rem 0.72rem;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 550;
    white-space: nowrap;
    cursor: pointer;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.65rem;
    background: var(--sl-color-black);
    transition: border-color 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .whale-copy-page:hover,
  .whale-copy-page[data-copied='true'] {
    color: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
  }

  .whale-copy-page:active {
    transform: translateY(1px);
  }

  .whale-page-kicker {
    color: var(--sl-color-accent);
    font-size: 0.88rem;
    font-weight: 650;
  }

  p {
    color: var(--sl-color-gray-2);
    font-size: 1.05rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  @media (max-width: 50rem) {
    .whale-copy-page { display: none; }
  }
</style>
