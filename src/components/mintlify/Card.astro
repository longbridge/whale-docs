---
import {
  BadgeCheck,
  ChartCandlestick,
  CircleCheck,
  Code,
  Database,
  FilePen,
  KeyRound,
  Link as LinkIcon,
  Palette,
  Plug,
  Puzzle,
  RotateCw,
  Ruler,
  Server,
  Shapes,
  SlidersHorizontal,
  Smartphone,
  TriangleAlert,
  Type,
  Users,
} from 'lucide-astro';

interface Props { title: string; href?: string; icon?: string }
const { title, href, icon } = Astro.props;
const Tag = href ? 'a' : 'article';
const icons = {
  'badge-check': BadgeCheck,
  'chart-candlestick': ChartCandlestick,
  'circle-check': CircleCheck,
  code: Code,
  database: Database,
  'file-pen': FilePen,
  key: KeyRound,
  link: LinkIcon,
  mobile: Smartphone,
  palette: Palette,
  plug: Plug,
  rotate: RotateCw,
  ruler: Ruler,
  server: Server,
  shapes: Shapes,
  sliders: SlidersHorizontal,
  smartphone: Smartphone,
  'triangle-exclamation': TriangleAlert,
  type: Type,
  users: Users,
} as const;
const CardIcon = icons[icon as keyof typeof icons] ?? Puzzle;
---
<Tag class="whale-card" href={href}>
  <span class="whale-card-icon" aria-hidden="true"><CardIcon size={19} strokeWidth={1.8} /></span>
  <span class="whale-card-copy">
    <strong>{title}</strong>
    <span><slot /></span>
  </span>
  {href && <span class="whale-card-arrow" aria-hidden="true">→</span>}
</Tag>
