---
import { ChevronDown } from 'lucide-astro';
import TocItem from './TocItem.astro';
import { DocsToc } from './DocsToc';
const { toc } = Astro.locals.starlightRoute;
const locale = Astro.url.pathname.split('/')[1] || 'en';
const helpful = locale === 'en' ? 'Was this helpful?' : locale === 'zh-cn' ? '这篇文档有帮助吗？' : '這篇文件有幫助嗎？';
const onThisPage = locale === 'en' ? 'On this page' : locale === 'zh-cn' ? '在此页面' : '在此頁面';
const yesLabel = locale === 'en' ? 'Yes' : locale === 'zh-cn' ? '有帮助' : '有幫助';
const noLabel = locale === 'en' ? 'No' : locale === 'zh-cn' ? '没有帮助' : '沒有幫助';
---

{toc && (
  <>
    <div class="whale-mobile-toc">
      <details>
        <summary>{Astro.locals.t('tableOfContents.onThisPage')}<ChevronDown size={14} aria-hidden="true" /></summary>
        <ul>{toc.items.map((item) => <TocItem item={item} />)}</ul>
      </details>
    </div>
    <div class="right-sidebar-panel sl-hidden lg:sl-block">
      <nav aria-label={onThisPage}><DocsToc client:load items={toc.items} label={onThisPage} helpful={helpful} yesLabel={yesLabel} noLabel={noLabel} /></nav>
    </div>
  </>
)}
