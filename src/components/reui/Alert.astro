---
import { CircleAlert, Info, Lightbulb, TriangleAlert } from 'lucide-astro';
import { Alert, AlertDescription, AlertTitle } from './alert';

interface Props {
  variant?: 'info' | 'success' | 'warning' | 'destructive';
  title?: string;
}

const { variant = 'info', title } = Astro.props;
const locale = Astro.url.pathname.split('/')[1] || 'en';
const fallbacks = locale === 'en'
  ? { info: 'Note', success: 'Tip', warning: 'Warning', destructive: 'Important' }
  : locale === 'zh-cn'
    ? { info: '说明', success: '提示', warning: '警告', destructive: '重要' }
    : { info: '說明', success: '提示', warning: '警告', destructive: '重要' };
const definitions = {
  info: { icon: Info, fallback: fallbacks.info },
  success: { icon: Lightbulb, fallback: fallbacks.success },
  warning: { icon: TriangleAlert, fallback: fallbacks.warning },
  destructive: { icon: CircleAlert, fallback: fallbacks.destructive },
};
const definition = definitions[variant];
const AlertIcon = definition.icon;
---

<Alert className="reui-alert" variant={variant} data-variant={variant}>
  <AlertIcon aria-hidden="true" size={16} strokeWidth={1.8} />
  <AlertTitle>{title ?? definition.fallback}</AlertTitle>
  <AlertDescription><slot /></AlertDescription>
</Alert>
