{
  "name": "@longbridge/astro-theme-docs",
  "version": "0.1.0",
  "type": "module",
  "description": "Astro documentation theme \u2014 layouts, UI components and Markdown pipeline for docs sites built on nimbus-docs.",
  "license": "MIT",
  "keywords": [
    "astro",
    "astro-theme",
    "documentation",
    "docs",
    "nimbus-docs",
    "tailwindcss"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/longbridge/whale-docs.git",
    "directory": "packages/astro-theme-docs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "components.ts",
    "src",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.client.ts"
  ],
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./components": {
      "types": "./components.ts",
      "default": "./components.ts"
    },
    "./ui/*": "./src/components/ui/*/index.ts",
    "./chrome/*": "./src/components/chrome/*.astro",
    "./mdx/*": "./src/components/mdx/*.astro",
    "./layouts/*": "./src/layouts/*.astro",
    "./markdown": "./src/markdown/index.ts",
    "./api/*": "./src/components/api/*.astro",
    "./react/*": "./src/react/*",
    "./lib/*": "./src/lib/*.ts",
    "./util/*": "./src/util/*.ts",
    "./scripts/*": "./src/scripts/*.ts",
    "./styles/*": "./src/styles/*",
    "./src/styles/*": "./src/styles/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "astro check",
    "test": "bun test"
  },
  "dependencies": {
    "@lucide/astro": "^1.26.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.25.0",
    "marked": "^18.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "@astrojs/react": ">=3.0.0",
    "@base-ui/react": ">=1.0.0",
    "@tailwindcss/vite": ">=4.0.0",
    "astro": ">=5.0.0",
    "nimbus-docs": ">=0.5.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "optionalDependencies": {
    "@pagefind/default-ui": "^1.1.0",
    "medium-zoom": "^1.1.0",
    "mermaid": "^11.16.0",
    "tippy.js": "^6.3.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@happy-dom/global-registrator": "^20.11.1",
    "@types/hast": "^3.0.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "bun-types": "^1.3.14",
    "typescript": "^6"
  }
}
