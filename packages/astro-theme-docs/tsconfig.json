{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // Deliberately empty. The root tsconfig maps `@/*` and `~/*` to
    // src/nimbus/*; inheriting that here would let a stray `@/foo` import in
    // this package silently resolve into the consuming site's source tree and
    // still typecheck, then fail once published. No aliases means every
    // internal import has to be relative or a real package specifier.
    "paths": {}
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.astro"],
  "exclude": ["node_modules", "dist"]
}
