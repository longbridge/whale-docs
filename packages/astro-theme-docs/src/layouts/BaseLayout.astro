---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/globals.css";
import "../styles/prose.css";
import "../styles/markdown-pipeline.css";
import "tippy.js/dist/tippy.css";
import "../styles/tippy.css";
import "../styles/footnotes.css";
import PageHead from "../components/PageHead.astro";
import type { PageMeta } from "../components/PageHead.astro";
import type { BasePageProps } from "nimbus-docs/types";
import { ClientRouter } from "astro:transitions";

type Props = BasePageProps & { footer?: boolean; meta?: PageMeta; siteName?: string; faviconHref?: string };
const { title, description, noindex, socialImage, head = [], meta, siteName, faviconHref } = Astro.props;
const path = Astro.url.pathname;
const lang = path.startsWith("/zh-cn/") ? "zh-CN" : path.startsWith("/zh-hk/") ? "zh-HK" : "en";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Pre-paint theme resolution — runs before first paint to avoid FOUC.
      // Reads the saved preference ("ui-mode": light | dark | auto), resolves
      // "auto" against the OS setting, and applies it to <html> via the
      // attributes the stylesheet keys off (data-mode for dark, data-nb-pref
      // for the toggle icon). ThemeToggle only writes localStorage and calls
      // window.__nbApplyTheme, so this script owns all DOM application.
      (function () {
        function apply() {
          var pref = "auto";
          try {
            var v = localStorage.getItem("ui-mode");
            if (v === "light" || v === "dark" || v === "auto") pref = v;
          } catch (e) {}
          var systemDark = false;
          try {
            systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          } catch (e) {}
          var mode = pref === "dark" || (pref === "auto" && systemDark) ? "dark" : "light";
          var root = document.documentElement;
          root.setAttribute("data-nb-pref", pref);
          root.setAttribute("data-mode", mode);
          root.setAttribute("data-theme", mode);
          root.style.colorScheme = mode;
        }
        window.__nbApplyTheme = apply;
        apply();
        if (!window.__nbThemeBound) {
          window.__nbThemeBound = true;
          try {
            window
              .matchMedia("(prefers-color-scheme: dark)")
              .addEventListener("change", function () {
                if (window.__nbApplyTheme) window.__nbApplyTheme();
              });
          } catch (e) {}
          // ClientRouter view transitions replace <html>; reapply after swap.
          document.addEventListener("astro:after-swap", function () {
            if (window.__nbApplyTheme) window.__nbApplyTheme();
          });
        }
      })();
    </script>
    <PageHead title={title} description={description} noindex={noindex} socialImage={socialImage} head={head} meta={meta} siteName={siteName} faviconHref={faviconHref} />
    <ClientRouter />
  </head>
  <body class="bg-background text-foreground min-h-screen">
    <a href="#main-content" class="focus:bg-primary focus:text-primary-foreground sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-100 focus:rounded-md focus:px-4 focus:py-2">Skip to content</a>
    <slot />
    <script>
      import { codeCopy } from "nimbus-docs/client";
      import "../scripts/mobile-sidebar.client";
      import "../scripts/mermaid.client";
      import "../scripts/table-scroll.client";
      import "../scripts/image-zoom.client";
      import "../scripts/footnotes.client";
      import "../scripts/scroll-to-top.client";
      codeCopy();
    </script>
  </body>
</html>
