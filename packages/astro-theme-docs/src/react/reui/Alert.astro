---
import { CircleAlert, Info, Lightbulb, TriangleAlert } from '@lucide/astro';
import { Alert, AlertDescription, AlertTitle } from '../ui/alert';

interface Props {
  variant?: 'default' | 'info' | 'success' | 'warning' | 'destructive';
  title?: string;
}

const { variant = 'default', title } = Astro.props;
// Titles are not localized — the label stays English across locales.
const definitions = {
  default: { icon: Info, label: 'Note' },
  info: { icon: Info, label: 'Note' },
  success: { icon: Lightbulb, label: 'Tip' },
  warning: { icon: TriangleAlert, label: 'Warning' },
  destructive: { icon: CircleAlert, label: 'Important' },
};
const definition = definitions[variant];
const AlertIcon = definition.icon;
const displayTitle = title ?? definition.label;
---

<Alert className="reui-alert" variant={variant} data-variant={variant}>
  <AlertIcon aria-hidden="true" size={16} stroke-width={2} />
  <AlertTitle>{displayTitle}</AlertTitle>
  <AlertDescription><slot /></AlertDescription>
</Alert>
