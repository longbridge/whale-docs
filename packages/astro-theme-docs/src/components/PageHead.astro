---
import type { HeadElement } from "nimbus-docs/types";

export interface PageMeta {
  titleSuffix?: string;
  canonical?: string;
}

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  socialImage?: string;
  head?: HeadElement[];
  meta?: PageMeta;
}

const { title, description, noindex, socialImage, head = [], meta } = Astro.props;
const pageTitle = title === "Whale Docs" ? title : `${title} · Whale Docs`;
const canonical = meta?.canonical
  ? new URL(meta.canonical, Astro.site ?? Astro.url).href
  : Astro.url.href;
---

<title>{pageTitle}</title>
{description && <meta name="description" content={description} />}
{noindex && <meta name="robots" content="noindex,nofollow" />}
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/png" href="https://assets.lbkrs.com/uploads/288a4391-d68f-45f2-aedc-007306bab1a5/whale-icon.png" />
<meta property="og:title" content={pageTitle} />
{description && <meta property="og:description" content={description} />}
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
{socialImage && <meta property="og:image" content={socialImage} />}
{
  head.map((item) => {
    if (item.tag === "title") return <title>{item.content}</title>;
    if (item.tag === "meta") return <meta {...item.attrs} />;
    if (item.tag === "link") return <link {...item.attrs} />;
    return null;
  })
}
