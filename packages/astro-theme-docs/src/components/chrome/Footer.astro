---
import LucideIcon from "../ui/icon/LucideIcon.astro";

interface Props {
  /** URL the logo links to. Default: "/" */
  siteHref?: string;
  /** Light-mode logo src. */
  logoLightSrc?: string;
  /** Dark-mode logo src. */
  logoDarkSrc?: string;
  /** Alt text for the logo image. */
  logoAlt?: string;
  /** Copyright entity name, e.g. "Acme Corp" */
  siteName?: string;
  /** Contact email shown below the logo. */
  siteEmail?: string;
  /** Contact phone number(s) shown below the logo (up to 2). */
  phones?: [string?, string?];
}

const {
  siteHref = "/",
  logoLightSrc = "",
  logoDarkSrc = "",
  logoAlt = "",
  siteName = "",
  siteEmail,
  phones = [],
} = Astro.props;

const year = new Date().getFullYear();
const copyrightName = siteName ? siteName.toUpperCase() : "";
---

<footer id="footer" class="border-border mt-auto flex w-full flex-col items-center border-t">
  <div class="z-20 flex w-full flex-col gap-12 px-(--nb-shell-gutter) py-16 md:py-20 lg:py-28">
    <div class="flex flex-col justify-between gap-12 md:flex-row">
      <!-- Brand + contact -->
      <div class="flex flex-col justify-between gap-10 md:min-w-56">
        <a href={siteHref} target="_blank" rel="noreferrer" aria-label={logoAlt || siteName} class="w-fit">
          {logoLightSrc && <img src={logoLightSrc} alt={logoAlt} class="logo-light h-[26px] w-auto max-w-48 object-contain" />}
          {logoDarkSrc && <img src={logoDarkSrc} alt={logoAlt} class="logo-dark h-[26px] w-auto max-w-48 object-contain" />}
        </a>
        {(siteEmail || phones.length > 0) && (
          <div class="text-muted-foreground flex flex-col gap-2 text-sm">
            {phones[0] && <a class="hover:text-foreground w-fit" href={`tel:${phones[0]}`}>{phones[0]}</a>}
            {phones[1] && <a class="hover:text-foreground w-fit" href={`tel:${phones[1]}`}>{phones[1]}</a>}
            {siteEmail && <a class="hover:text-foreground w-fit" href={`mailto:${siteEmail}`}>{siteEmail}</a>}
          </div>
        )}
      </div>
      <!-- Link columns: injected by consumer via default slot -->
      <slot />
    </div>
    <div class="border-border text-muted-foreground flex flex-col-reverse items-start gap-4 border-t pt-8 text-sm md:flex-row md:items-center md:justify-between">
      <span>{copyrightName ? `© ${year} ${copyrightName}. All rights reserved.` : `© ${year}`}</span>
      <div class="flex items-center gap-4">
        <slot name="bottom-links" />
        <a href={siteHref} target="_blank" rel="noreferrer" aria-label={siteName || "website"}><LucideIcon name="globe" class="size-5" /></a>
      </div>
    </div>
  </div>
</footer>
