---
/**
 * Renders a Lucide icon by its kebab-case name (e.g. "rocket", "book-open",
 * "square-terminal"). Backed by @lucide/astro; the whole set is indexed by
 * name so data-driven icons (docs.json groups, nav tabs) resolve at build time.
 * Unknown names fall back to a neutral folder glyph.
 *
 * All extra props (class, size, aria-*, data-*, ...) are forwarded to the
 * underlying <svg>, so it is a drop-in for the former astro-icon <Icon>.
 */
import * as lucide from "@lucide/astro";

interface Props {
  name: string;
  [key: string]: unknown;
}

const { name, ...rest } = Astro.props;

const toPascalCase = (value: string): string =>
  value
    .split(/[-_]/)
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join("");

const registry = lucide as unknown as Record<string, unknown>;
const Component = (registry[toPascalCase(name)] ?? registry.Folder) as (
  _props: Record<string, unknown>,
) => unknown;
---

<Component {...rest} />
