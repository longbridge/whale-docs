---
/**
 * Code — syntax-highlighted code block from a string prop.
 *
 *   <Code code={generated} lang="ts" />
 *   <Code code={...} lang="ts" meta='title="src/foo.ts" {1,3-5}' />
 */
import { Code as AstroCode } from "astro:components";
import { defaultCodeTransformers } from "nimbus-docs";

type Props = Parameters<typeof AstroCode>[0];
const rawProps = Astro.props as Props;
const usesNimbusDefaultThemes =
	!("theme" in rawProps) && !("themes" in rawProps);
const themed = usesNimbusDefaultThemes
	? {
			...rawProps,
			themes: { light: "github-light", dark: "github-dark" },
			defaultColor: false,
		}
	: rawProps;
const userTransformers = themed.transformers ?? [];
// `defaultCodeTransformers` is typed against the @shikijs/types that
// nimbus-docs resolves; AstroCode is typed against the one Astro resolves.
// Same version, different resolution paths, so TypeScript treats the two
// ShikiTransformer types as unrelated and both directions need a bridge --
// the argument going in and the array coming out. Runtime is unaffected:
// there is only one @shikijs/types installed.
const props = {
	...themed,
	transformers: defaultCodeTransformers({
		classTokens: usesNimbusDefaultThemes,
		beforeTitleTransformers: userTransformers as never,
	}) as unknown as Props["transformers"],
};
---

{/* `props` is a union (the theme/themes branches above), and AstroCode's own
    Props is a discriminated union too. Spreading one union into another is
    something TypeScript will not verify, so assert at the boundary. */}
<AstroCode {...(props as Props)} />

