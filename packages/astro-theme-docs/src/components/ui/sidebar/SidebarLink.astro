---
import { cn } from "../../../lib/cn";
import type { HTMLAttributes } from "astro/types";
import { Badge } from "../badge";
import type { SidebarBadge } from "nimbus-docs/types";

interface Props extends HTMLAttributes<"a"> {
	label: string;
	href: string;
	isCurrent?: boolean;
	badge?: SidebarBadge;
}

const {
	label,
	href,
	isCurrent,
	badge,
	class: className,
	...attrs
} = Astro.props;
---

<a
	href={href}
	aria-current={isCurrent ? "page" : undefined}
	data-nb-sidebar-link
	class={className ? cn(className) : undefined}
	{...attrs}
>
	{
		badge &&
			<span class="api-method-slot">
				{typeof badge === "string" ? (
					<Badge text={badge} class={`api-method-badge api-method-${badge.toLowerCase()}`} />
				) : (
					<Badge text={badge.text} variant={badge.variant} class={`api-method-badge api-method-${badge.text.toLowerCase()}`} />
				)}
			</span>
	}
	<span class="min-w-0 break-words">{label}</span>
</a>
