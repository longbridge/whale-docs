---
import 'astro-theme-docs/src/styles/globals.css';
import 'astro-theme-docs/src/styles/prose.css';
import 'astro-theme-docs/src/styles/markdown-pipeline.css';
import 'astro-theme-docs/src/styles/footnotes.css';
import 'astro-theme-docs/src/styles/tippy.css';
import '../styles/brand.css';

interface Props {
  title?: string;
}
const { title = 'Demo' } = Astro.props;
---
<!doctype html>
<html lang="en" data-mode="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-background text-foreground min-h-screen p-8">
    <main class="max-w-3xl mx-auto prose">
      <slot />
    </main>
  </body>
</html>
