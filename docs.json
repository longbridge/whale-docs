{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "Whale API",
  "colors": {
    "primary": "#7245F2",
    "light": "#9B7BF6",
    "dark": "#5B32D6"
  },
  "favicon": "/logo/whale-mark.png",
  "logo": {
    "light": "/logo/whale-light.png",
    "dark": "/logo/whale-dark.png",
    "href": "https://longbridgewhale.com"
  },
  "icons": {
    "library": "lucide"
  },
  "contextual": {
    "options": [
      "copy",
      "chatgpt",
      "claude",
      "cursor",
      "vscode"
    ]
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "navbar": {
          "links": [
            {
              "label": "Longbridge Whale",
              "href": "https://longbridgewhale.com"
            }
          ],
          "primary": {
            "type": "button",
            "label": "Get started",
            "href": "https://apidocs.longbridgewhale.com/en/quickstart"
          }
        },
        "tabs": [
          {
            "tab": "Documentation",
            "icon": "book-open",
            "groups": [
              {
                "group": "Get started",
                "icon": "rocket",
                "pages": [
                  "en/introduction",
                  "en/quickstart"
                ]
              },
              {
                "group": "Essentials",
                "icon": "shield-check",
                "pages": [
                  "en/essentials/authentication",
                  "en/essentials/passthrough-headers"
                ]
              }
            ]
          },
          {
            "tab": "API Reference",
            "icon": "file-json",
            "openapi": "openapi.json"
          }
        ]
      },
      {
