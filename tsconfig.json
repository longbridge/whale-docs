{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["src/nimbus/*"],
      "~/*": ["src/nimbus/*"],
      "@components/*": ["src/components/*"],
      // Mirrors the `@theme` Vite alias in src/nimbus/astro-config.ts so
      // `astro check` resolves theme internals the same way the build does.
      // Both go away at the end of the migration, when imports move to the
      // package's public subpaths.
      "@theme/*": ["packages/astro-theme-docs/src/*"],
    },
  },
  "include": [".astro/types.d.ts", "src/nimbus/**/*"],
  // The theme package is type-checked by its own `astro check` (see
  // packages/astro-theme-docs/tsconfig.json), not from here — it has to stand
  // on its own to be publishable.
  "exclude": [
    // Excluded for pre-existing type errors that the package copies have since
    // had fixed; these entries disappear as each file migrates to the theme.
    "src/nimbus/components/ui/code/**/*",
    "src/nimbus/components/ui/package-managers/**/*",
    "src/nimbus/components/ui/search/**/*",
    "src/nimbus/util/**/*",
    // Uses bun:test; run with `bun test`.
    "src/nimbus/**/*.test.ts",
  ],
}
